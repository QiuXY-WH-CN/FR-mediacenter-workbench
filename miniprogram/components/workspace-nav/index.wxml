<view class="nav-component"><view class="workspace-header {{dark ? 'dark' : ''}}" style="--accent:{{theme}}"><view class="workspace-brand"><image src="/images/emblem.png" mode="aspectFit"/><view>冯如学媒<view class="workspace-caption">{{language === 'en' ? 'Collaboration workspace' : '协作工作台'}}</view></view></view><button class="workspace-menu" style="width:88rpx;min-width:44px;flex:none;" bindtap="toggle" aria-label="{{menuLabel}}">☰</button></view>
<view wx:if="{{open}}" class="nav-backdrop" bindtap="close"><view class="nav-drawer {{dark ? 'dark' : ''}}" style="--accent:{{theme}}" catchtap="noop"><view class="drawer-heading"><text>冯如学媒</text><button style="width:88rpx;min-width:44px;flex:none;" bindtap="close" aria-label="{{language === 'en' ? 'Close' : '关闭'}}">×</button></view><scroll-view scroll-y class="drawer-links"><view wx:for="{{items}}" wx:key="id" class="drawer-link {{current === item.id ? 'selected' : ''}}" data-url="{{item.url}}" bindtap="go"><text class="drawer-icon">{{item.icon}}</text>{{item.label}}</view></scroll-view><view class="drawer-profile" data-url="/pages/profile/index" bindtap="go"><image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill"/><view class="avatar-fallback" wx:else>◉</view><view><view>{{user.name}}</view><view class="workspace-caption">{{profileLabel}} ›</view></view></view></view></view></view>