.workspace-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx;color:#252525}.workspace-brand{display:flex;align-items:center;gap:16rpx;font-size:32rpx;font-weight:650}.workspace-brand image{width:54rpx;height:62rpx}.workspace-caption{font-size:22rpx;color:#777;font-weight:400;margin-top:2rpx}.workspace-menu,.drawer-heading button{background:transparent;border:1rpx solid #e5e5e5;color:inherit;border-radius:16rpx;padding:8rpx 24rpx;font-size:32rpx;margin:0;line-height:1.5}.workspace-menu::after,.drawer-heading button::after{border:0}.nav-backdrop{position:fixed;inset:0;z-index:90;background:#0006}.nav-drawer{position:absolute;left:0;top:0;bottom:0;width:82vw;max-width:600rpx;background:#fff;display:flex;flex-direction:column;padding:32rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box;animation:drawer-in .22s ease-out;color:#252525}.drawer-heading{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:650;padding-bottom:24rpx}.drawer-links{flex:1;min-height:0;height:0}.drawer-link{display:flex;align-items:center;gap:22rpx;min-height:92rpx;border-radius:18rpx;padding:0 22rpx;font-size:29rpx;margin:6rpx 0;box-sizing:border-box}.drawer-link.selected{color:var(--accent);background:#8881}.drawer-icon{width:32rpx;text-align:center}.drawer-profile{display:flex;align-items:center;gap:20rpx;border-top:1rpx solid #8883;padding-top:24rpx;margin-top:18rpx;font-size:28rpx}.drawer-profile image,.avatar-fallback{width:72rpx;height:72rpx;border-radius:50%;background:#8882;text-align:center;line-height:72rpx}.dark{background:#101010;color:#eee}.dark .workspace-caption{color:#aaa}@keyframes drawer-in{from{transform:translateX(-100%)}to{transform:translateX(0)}}
.workspace-menu{width:88rpx;min-width:44px;min-height:44px;flex:none;margin-left:24rpx}.workspace-header{font-size:calc(30rpx * var(--font-scale,1))}

.nav-component{position:relative;z-index:40}.workspace-menu,.drawer-heading button{width:88rpx!important;max-width:88rpx!important;min-width:44px!important;flex:none!important;box-sizing:border-box}.workspace-brand{flex:1;min-width:0}.workspace-header{width:100%}
