<view class="page"><view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>冯如学媒</view><view class="eyebrow">FENGRU · WORKSPACE</view><view class="title">{{user.name || '你好'}}，欢迎回来。</view><view wx:if="syncError" class="error">{{syncError}}</view><view class="stats"><view class="stat" wx:for="{{stats}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="number">{{item.count}}</view></view></view><view class="actions"><button class="primary" wx:if="manager" data-url="/pages/editor/index?mode=event-new" bindtap="go">＋ 新建活动</button><button data-url="/pages/events/index" bindtap="go">活动协作</button></view><view class="card"><view class="row"><view class="h2">近期日程</view><text class="link small" data-url="/pages/calendar/index" bindtap="go">完整日历 ›</text></view><view class="task" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><view class="reward">{{item.dateLabel}}</view><view class="h3">{{item.name}}</view><view class="muted">{{item.location || '地点待定'}}</view></view><view wx:if="!events.length" class="empty">近期还没有活动</view></view><view class="card"><view class="h2">需要处理</view><view class="task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row start"><view class="grow"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}}</view></view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.dueLabel}} · {{item.ownerName}}</view></view><view wx:if="!tasks.length" class="empty">暂无待办任务</view></view><view class="card"><view class="h2">最近动态</view><view class="split muted" wx:for="{{notices}}" wx:key="index">{{item.text}}</view></view></view>
