<view class="page"><view class="title">{{title}}</view><view wx:if="error || syncError" class="error">{{error || syncError}}</view><view wx:if="templateHint" class="hint">{{templateHint}}</view><view wx:for="{{fields}}" wx:for-item="field" wx:key="key" class="field"><text class="label">{{field.label}}</text><picker wx:if="field.type === 'select'" range="{{field.options}}" range-key="label" value="{{field.selected}}" data-index="{{index}}" bindchange="change"><view class="picker">{{field.display}} ▾</view></picker><picker wx:elif="field.type === 'date' || field.type === 'time'" mode="{{field.type}}" value="{{field.value}}" data-index="{{index}}" bindchange="change"><view class="picker">{{field.value}}</view></picker><switch wx:elif="field.type === 'switch'" checked="{{field.value}}" color="#f58220" data-index="{{index}}" bindchange="change"/><textarea wx:elif="field.type === 'textarea'" value="{{field.value}}" data-index="{{index}}" bindinput="change" maxlength="3000"/><checkbox-group wx:elif="field.type === 'checks'" data-index="{{index}}" bindchange="change"><label wx:for="{{field.options}}" wx:for-item="choice" wx:key="value" class="check"><checkbox value="{{choice.value}}" color="#f58220"/>{{choice.label}}</label></checkbox-group><input wx:else value="{{field.value}}" type="{{field.type === 'number' ? 'number' : 'text'}}" password="{{field.type === 'password'}}" data-index="{{index}}" bindinput="change" maxlength="2000"/></view><view wx:if="isTemplate" class="actions"><button bindtap="addStep">＋ 添加环节</button><button bindtap="removeStep">移除末环节</button></view><view wx:if="isTemplate" class="hint">前序环节编号必须小于当前环节。模板仅定义流程，不绑定具体成员。</view><view class="card" wx:if="resultToken"><view class="h3">{{tokenLabel}}</view><view class="pre small">{{resultToken}}</view><view class="actions"><button bindtap="copy">复制代码</button><button wx:if="!isMember" open-type="share">分享邀请</button></view></view><button wx:if="isMember" bindtap="resetMember" class="safe-button" disabled="{{busy}}">生成密码重置码</button><view class="fixed-actions"><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">保存并同步</button></view></view>
