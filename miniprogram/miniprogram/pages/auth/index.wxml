<view class="page">
  <view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>冯如学媒</view>
  <view class="eyebrow">FENGRU MEDIA</view>
  <view class="title">{{pending ? '等待开通' : (mode === 'register' ? '申请加入' : (mode === 'recover' ? '重设密码' : '欢迎回来'))}}</view>
  <view class="muted">与网页共用账号，日程与任务在同一处同步。</view>
  <view wx:if="error" class="error">{{error}}</view>

  <view wx:if="pending" class="card">
    <view>{{pendingName}}，账号暂未开通，请联系管理员处理。</view>
    <view class="actions">
      <button bindtap="check">刷新状态</button>
      <button bindtap="logout">退出账号</button>
    </view>
  </view>

  <block wx:else>
    <view wx:if="mode !== 'recover'" class="field">
      <text class="label">用户名</text>
      <input value="{{username}}" data-key="username" bindinput="input" maxlength="32" placeholder="与网页账号一致"/>
    </view>

    <block wx:if="mode === 'register'">
      <view class="field"><text class="label">姓名</text><input value="{{name}}" data-key="name" bindinput="input" maxlength="30"/></view>
      <view class="field"><text class="label">部门</text><picker range="{{depts}}" value="{{deptIndex}}" bindchange="dept"><view class="picker">{{depts[deptIndex]}}</view></picker></view>
      <view class="field"><text class="label">邀请码（可选）</text><input value="{{invite}}" data-key="invite" bindinput="input" maxlength="128"/></view>
    </block>

    <view wx:if="mode === 'recover'" class="field">
      <text class="label">负责人提供的重置码</text>
      <input value="{{resetToken}}" data-key="resetToken" bindinput="input"/>
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input password value="{{password}}" data-key="password" bindinput="input" maxlength="72" placeholder="至少 10 个字符"/>
    </view>

    <view wx:if="mode !== 'login'" class="field">
      <text class="label">再次输入密码</text>
      <input password value="{{confirm}}" data-key="confirm" bindinput="input" maxlength="72"/>
    </view>

    <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{mode === 'login' ? '登录' : (mode === 'register' ? '提交申请' : '保存新密码')}}</button>

    <view class="actions">
      <button wx:if="cloud" disabled="{{busy}}" bindtap="wechat">微信一键登录</button>
      <button data-mode="{{mode === 'login' ? 'register' : 'login'}}" bindtap="mode">{{mode === 'login' ? '申请加入' : '返回登录'}}</button>
    </view>

    <view class="menu link" data-mode="recover" bindtap="mode">忘记密码 · 使用重置码</view>
  </block>

  <view class="menu link" bindtap="connection">连接设置 <text>›</text></view>
</view>
