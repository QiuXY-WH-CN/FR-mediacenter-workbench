<view class="page"><view class="title">贡献积分</view><view class="card"><view class="muted">我的累计积分</view><view class="points">{{total || 0}}</view><view class="muted">验收后入账一次，其他奖励由负责人兑现。</view></view><view class="h2">{{scope}}</view><view wx:if="syncError" class="error">{{syncError}}</view><view class="card" wx:for="{{ledger}}" wx:key="id"><view class="row"><view class="h3 grow">{{item.taskName}}</view><text class="reward">+{{item.points}}</text></view><view class="muted">{{item.eventName}} · {{item.name}}</view><view class="muted">{{item.timeLabel}}</view><view wx:if="item.note">其他奖励：{{item.note}}</view></view><view wx:if="!ledger.length" class="empty">验收后会产生贡献记录</view></view>
