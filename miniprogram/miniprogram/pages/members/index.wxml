<view class="page"><view class="title">成员与权限</view><button wx:if="manager" class="primary" data-url="/pages/editor/index?mode=invite" bindtap="go">＋ 邀请成员</button><view wx:if="syncError" class="error">{{syncError}}</view><view class="card" wx:for="{{members}}" wx:key="id"><view class="row"><view class="h2 grow">{{item.name}}</view><text class="tag">{{item.statusLabel}}</text></view><view class="muted">{{item.dept}} · {{item.roleLabel}}</view><view class="muted">@{{item.username}}</view><button wx:if="item.canEdit" class="safe-button" data-url="/pages/editor/index?mode=member&id={{item.id}}" bindtap="go">审批 / 管理</button></view></view>
