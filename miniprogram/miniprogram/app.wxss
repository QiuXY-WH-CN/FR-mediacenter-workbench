der-right:1rpx solid #eee2d1;padding:14rpx;text-align:center;font-size:26rpx}.time-day.selected{background:#fff6e4}.time-count{display:block;background:#ffebcb;color:#985213;border-radius:10rpx;padding:8rpx;font-size:22rpx;margin-top:14rpx;white-space:normal}.section-title{margin:26rpx 0 12rpx}.split{padding:20rpx 0;border-bottom:1rpx solid #eee}.tag{font-size:24rpx;background:#fff3dd;color:#9f5800;border-radius:8rpx;padding:3rpx 10rpx}.space{height:20rpx}.fixed-actions{position:sticky;bottom:0;background:#fff;padding:18rpx 0 calc(10rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee5dc;margin-top:22rpx;z-index:10}

