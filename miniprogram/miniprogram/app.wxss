page{background:#fff;color:#292623;font:30rpx/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;box-sizing:border-box;max-width:960px;margin:0 auto}view,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:16rpx;margin:0;line-height:1.5;padding:20rpx 26rpx;background:#fff;color:#292623;border:1rpx solid #e8e1d8}button::after{border:0}.page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));max-width:960px;margin:0 auto;width:100%}.title{font-size:44rpx;font-weight:700;line-height:1.35;margin:8rpx 0 18rpx}.h2{font-size:34rpx;font-weight:650}.h3{font-size:30rpx;font-weight:600}.eyebrow{font-size:22rpx;color:#ad4f0b;letter-spacing:3rpx}.muted{font-size:26rpx;color:#777067}.small{font-size:24rpx}.primary{background:#ff881f;border-color:#ff881f;color:#3f250d;font-weight:600}.secondary{border-color:#efc38e;color:#a74700}.danger{color:#c33232;border-color:#f0c0bb}.link{color:#b04b05}.card{border:1rpx solid #ebe6df;border-radius:22rpx;padding:28rpx;margin:24rpx 0;background:white}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.row.start{align-items:flex-start}.grow{flex:1;min-width:0}.wrap{flex-wrap:wrap}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:22rpx}.actions button{flex:1;min-width:180rpx}.stats{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:28rpx 0}.stat{border:1rpx solid #ebe6df;border-top:5rpx solid #ff901e;border-radius:20rpx;padding:24rpx}.stat:nth-child(2){border-top-color:#eeaf1c}.stat:nth-child(3){border-top-color:#e94935}.stat .number{font-size:52rpx;font-weight:700}.task{padding:24rpx 0;border-bottom:1rpx solid #eee8e0}.task:last-child{border:0}.badge{display:inline-block;border-radius:8rpx;padding:4rpx 12rpx;font-size:24rpx;white-space:nowrap;background:#f3f0eb;color:#6e6255}.badge.active,.badge.pending{background:#fff0dc;color:#a44600}.badge.review{background:#fff4c4;color:#916400}.badge.revise,.badge.conflict{background:#fff0ed;color:#b8342a}.reward{c