<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><view class="title">{{ui.s6}}</view><view class="card"><view class="muted">{{ui.s353}}</view><view class="points">{{total || 0}}</view><view class="muted">{{ui.s354}}</view></view><view class="card"><view class="h2">{{ui.s136}}</view><view class="task" wx:for="{{archives}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.statusLabel}}</view></view><view wx:if="{{!archives.length}}" class="muted">{{ui.s355}}</view></view><view class="h2">{{scope}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" wx:for="{{ledger}}" wx:key="id"><view class="row"><view class="h3 grow">{{item.taskName}}</view><text user-select="{{false}}" selectable="{{false}}" class="reward">+{{item.points}}</text></view><view class="muted">{{item.eventName}} · {{item.name}}</view><view class="muted">{{item.timeLabel}}</view><view wx:if="item.note">其他奖励：{{item.note}}</view></view><view wx:if="!ledger.length" class="empty">{{ui.s356}}</view></view>
</block>
