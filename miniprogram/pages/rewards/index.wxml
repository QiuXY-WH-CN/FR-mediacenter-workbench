<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">{{ui.s6}}</view><view class="card"><view class="muted">{{ui.s353}}</view><view class="points">{{total || 0}}</view><view class="muted">{{ui.s354}}</view></view><view class="card"><view class="h2">{{ui.s136}}</view><view class="task" wx:for="{{archives}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.statusLabel}}</view></view><view wx:if="{{!archives.length}}" class="muted">{{ui.s355}}</view></view><view class="h2">{{scope}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" wx:for="{{ledger}}" wx:key="id"><view class="row"><view class="h3 grow">{{item.taskName}}</view><text class="reward">+{{item.points}}</text></view><view class="muted">{{item.eventName}} · {{item.name}}</view><view class="muted">{{item.timeLabel}}</view><view wx:if="item.note">其他奖励：{{item.note}}</view></view><view wx:if="!ledger.length" class="empty">{{ui.s356}}</view><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
