<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot {{item.edge ? 'edge-dot edge-' + item.side : 'center-dot'}}" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;opacity:{{item.opacity || 1}};"/></view><view class="title">{{ui.s6}}</view><view class="card"><view class="muted">{{ui.s353}}</view><view class="points">{{total || 0}}</view><view class="muted">{{ui.s354}}</view></view><view class="card"><view class="h2">{{ui.s136}}</view><view class="task" wx:for="{{archives}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.statusLabel}}</view></view><view wx:if="{{!archives.length}}" class="muted">{{ui.s355}}</view></view><view class="h2">{{scope}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" wx:for="{{ledger}}" wx:key="id"><view class="row"><view class="h3 grow">{{item.taskName}}</view><text class="reward">+{{item.points}}</text></view><view class="muted">{{item.eventName}} · {{item.name}}</view><view class="muted">{{item.timeLabel}}</view><view wx:if="item.note">其他奖励：{{item.note}}</view></view><view wx:if="!ledger.length" class="empty">{{ui.s356}}</view></view>
</block>
