<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="rewards" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/><view class="title">{{ui.s6}}</view><view class="tabs"><view class="tab {{tab === item.id ? 'selected' : ''}}" wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bindtap="tab">{{item.label}}</view></view><view wx:if="{{syncError}}" class="error">{{syncError}}</view>
<block wx:if="{{tab === 'series'}}"><view class="series-toolbar"><picker range="{{years}}" value="{{yearIndex}}" bindchange="year"><view class="picker">{{year}} {{language === 'en' ? 'academic year' : '学年'}} ▾</view></picker><input value="{{query}}" bindinput="search" placeholder="{{language === 'en' ? 'Search series or goals' : '搜索系列或年度目标'}}" confirm-type="search"/></view><view class="card series-card" wx:for="{{seriesCards}}" wx:for-item="series" wx:key="id"><view class="row"><view class="h2 grow">{{series.name}}</view><text class="tag">{{series.eventCount}} {{language === 'en' ? 'schedules' : '个日程'}}</text></view><view class="muted">{{series.description}}</view><view class="muted small">{{series.completedCount}} {{language === 'en' ? 'completed' : '个已完成'}} · {{year}} {{language === 'en' ? 'academic year' : '学年'}}</view><view class="goal-row" wx:for="{{series.goals}}" wx:for-item="goal" wx:key="id"><view class="row"><view class="h3 grow">{{goal.name}}</view><text class="reward">{{goal.completed || 0}} / {{goal.target}}</text></view><view class="muted small">{{goal.department || '全体协作'}} · {{goal.metricLabel}}</view><view class="goal-track"><view class="goal-progress" style="width:{{goal.progress}}%;"/></view><view wx:if="{{goal.canEdit}}" class="link small" data-id="{{series.id}}" data-goal="{{goal.id}}" bindtap="removeGoal">{{language === 'en' ? 'Delete goal' : '删除目标'}}</view></view><view wx:if="{{!series.goals.length}}" class="muted small series-empty">{{language === 'en' ? 'No goals for this academic year' : '本学年尚未设置目标'}}</view><view class="series-event" wx:for="{{series.events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><view class="grow"><view class="h3">{{item.name}}</view><view class="muted small">{{item.dateLabel}}</view></view><text class="badge">{{item.scheduleLabel}}</text><text>›</text></view><view wx:if="{{series.hasMore}}" class="link small" data-id="{{series.id}}" bindtap="expandSeries">{{series.expanded ? (language === 'en' ? 'Collapse' : '收起日程') : (language === 'en' ? 'View all schedules' : '查看全部日程')}}</view><view class="actions" wx:if="{{manager}}"><button data-url="/pages/editor/index?mode=series-goal&id={{series.id}}" bindtap="go">{{language === 'en' ? 'Annual goal' : '年度目标'}}</button><button wx:if="{{admin}}" data-url="/pages/editor/index?mode=series-edit&id={{series.id}}" bindtap="go">{{language === 'en' ? 'Edit series' : '编辑系列'}}</button></view></view><view wx:if="{{!seriesCards.length}}" class="empty">{{language === 'en' ? 'No matching series' : '没有符合条件的系列'}}</view></block>
<block wx:elif="{{tab === 'results'}}"><view class="series-toolbar"><input value="{{query}}" bindinput="search" placeholder="{{language === 'en' ? 'Search results, schedules or members' : '搜索成果、日程或成员'}}" confirm-type="search"/></view><view class="actions"><button data-url="/pages/events/index" bindtap="go">{{language === 'en' ? 'Task archive' : '查看任务归档'}}</button></view><view class="card" wx:for="{{archives}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="h3 grow">{{item.name}}</view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted small">{{item.eventName}} · {{item.ownerName}}</view><view class="archive-excerpt">{{item.submission}}</view><view class="muted small">{{item.dueLabel}}</view></view><view wx:if="{{!archives.length}}" class="empty">{{ui.s355}}</view></block>
<block wx:else><view class="card"><view class="muted">{{ui.s353}}</view><view class="points">{{total || 0}}</view><view class="muted">{{ui.s354}}</view></view><view class="h2">{{scope}}</view><view class="card" wx:for="{{ledger}}" wx:key="id"><view class="row"><view class="h3 grow">{{item.taskName}}</view><text class="reward">+{{item.points}}</text></view><view class="muted">{{item.eventName}} · {{item.name}}</view><view class="muted">{{item.timeLabel}}</view><view wx:if="{{item.note}}">其他奖励：{{item.note}}</view></view><view wx:if="{{!ledger.length}}" class="empty">{{ui.s356}}</view></block></view></block>
