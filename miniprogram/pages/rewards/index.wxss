.series-toolbar{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:24rpx}.series-toolbar picker{flex:1 1 260rpx}.series-toolbar input{flex:1 1 340rpx}.series-card .h2{margin-bottom:10rpx}.goal-row{padding:22rpx 0;border-bottom:1rpx solid #8882}.goal-track{height:12rpx;background:#8882;border-radius:12rpx;overflow:hidden;margin:16rpx 0 6rpx}.goal-progress{height:100%;border-radius:12rpx;background:var(--accent);transition:width .3s}.series-event{display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #8882}.series-event .badge{font-size:calc(23rpx * var(--font-scale,1));max-width:35%;white-space:normal}.series-empty{padding:20rpx 0}.archive-excerpt{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap;margin:18rpx 0;font-size:calc(27rpx * var(--font-scale,1));color:#656565}.dark .archive-excerpt{color:#bbb}
