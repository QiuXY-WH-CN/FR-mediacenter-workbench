<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>冯如学媒</view><button class="workspace-switch" bindtap="workspace">{{workspace}} ▾</button><view class="eyebrow">FENGRU · WORKSPACE</view><view class="title">{{user.name || '你好'}}，欢迎回来。</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">急急急 · {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text class="priority {{item.priority}}">{{item.priorityLabel}}优先级</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="stats"><view class="stat" wx:for="{{stats}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="number">{{item.count}}</view></view></view><view class="actions"><button class="primary" wx:if="{{ manager }}" data-url="/pages/editor/index?mode=event-new" bindtap="go">＋ 新建活动</button><button data-url="/pages/events/index" bindtap="go">所有任务</button></view><view class="card"><view class="row"><view class="h2">近期日程</view><text class="link small" data-url="/pages/calendar/index" bindtap="go">完整日历 ›</text></view><view class="task" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><view class="reward">{{item.dateLabel}}</view><view class="h3">{{item.name}}</view><view class="muted">{{item.location || '地点待定'}}</view></view><view wx:if="!events.length" class="empty">近期还没有活动</view></view><view class="card"><view class="h2">需要处理</view><view class="task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row start"><view class="grow"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}}</view></view><text class="priority {{item.priority}}">{{item.priorityLabel}}优先级</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.dueLabel}} · {{item.ownerName}}</view></view><view wx:if="!tasks.length" class="empty">暂无待办任务</view></view><view class="card"><view class="h2">贡献排行榜</view><view wx:for="{{ranking}}" wx:key="id" class="row split"><text>{{index+1}} · {{item.name}}</text><text class="muted">{{item.dept}}</text><text class="reward">{{item.points}} 分</text></view></view><view class="card"><view class="h2">最近动态</view><view class="split muted" wx:for="{{notices}}" wx:key="index">{{item.text}}</view></view></view>
