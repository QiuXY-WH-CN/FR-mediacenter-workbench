<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="home" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/><button class="workspace-switch" bindtap="workspace">{{workspace}} ▾</button><view class="eyebrow">FENGRU · WORKSPACE</view><view class="title">{{user.name || '你好'}}，欢迎回来。</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">{{ui.s394}} {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="stats"><view class="stat" wx:for="{{stats}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="number">{{item.count}}</view></view></view><view class="actions"><button class="primary" wx:if="{{ manager }}" data-url="/pages/editor/index?mode=event-new" bindtap="go">{{ui.s141}}</button><button data-url="/pages/events/index" bindtap="go">{{ui.s2}}</button></view><view class="overview-grid"><view class="card"><view class="row"><view class="h2">{{ui.s132}}</view><text user-select="{{false}}" selectable="{{false}}" class="link small" data-url="/pages/calendar/index" bindtap="go">{{ui.s133}}</text></view><view class="task" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><view class="reward">{{item.dateLabel}}</view><view class="h3">{{item.name}}</view><view class="muted">{{item.location || '地点待定'}}</view></view><view wx:if="{{!events.length}}" class="empty">{{ui.s347}}</view></view><view class="card"><view class="h2">{{ui.s129}}</view><view class="task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row start"><view class="grow"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}}</view></view><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><text user-select="{{false}}" selectable="{{false}}" class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.dueLabel}} · {{item.ownerName}}</view></view><view wx:if="{{!tasks.length}}" class="empty">{{ui.s348}}</view></view><view class="card"><view class="h2">{{ui.s134}}</view><view wx:for="{{ranking}}" wx:key="id" class="row split"><text user-select="{{false}}" selectable="{{false}}">{{index+1}} · {{item.name}}</text><text user-select="{{false}}" selectable="{{false}}" class="muted">{{item.dept}}</text><text user-select="{{false}}" selectable="{{false}}" class="reward">{{item.points}} 分</text></view></view><view class="card"><view class="h2">{{ui.s131}}</view><view class="split muted" wx:for="{{notices}}" wx:key="index">{{item.text}}</view></view></view></view>
</block>
