<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>{{ui.s14}}</view><button class="workspace-switch" bindtap="workspace">{{workspace}} ▾</button><view class="eyebrow">FENGRU · WORKSPACE</view><view class="title">{{user.name || '你好'}}，欢迎回来。</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">{{ui.s394}} {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="stats"><view class="stat" wx:for="{{stats}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="number">{{item.count}}</view></view></view><view class="actions"><button class="primary" wx:if="{{ manager }}" data-url="/pages/editor/index?mode=event-new" bindtap="go">{{ui.s141}}</button><button data-url="/pages/events/index" bindtap="go">{{ui.s2}}</button></view><view class="card"><view class="row"><view class="h2">{{ui.s132}}</view><text class="link small" data-url="/pages/calendar/index" bindtap="go">{{ui.s133}}</text></view><view class="task" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><view class="reward">{{item.dateLabel}}</view><view class="h3">{{item.name}}</view><view class="muted">{{item.location || '地点待定'}}</view></view><view wx:if="!events.length" class="empty">{{ui.s347}}</view></view><view class="card"><view class="h2">{{ui.s129}}</view><view class="task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row start"><view class="grow"><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}}</view></view><text class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.dueLabel}} · {{item.ownerName}}</view></view><view wx:if="!tasks.length" class="empty">{{ui.s348}}</view></view><view class="card"><view class="h2">{{ui.s134}}</view><view wx:for="{{ranking}}" wx:key="id" class="row split"><text>{{index+1}} · {{item.name}}</text><text class="muted">{{item.dept}}</text><text class="reward">{{item.points}} 分</text></view></view><view class="card"><view class="h2">{{ui.s131}}</view><view class="split muted" wx:for="{{notices}}" wx:key="index">{{item.text}}</view></view><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
