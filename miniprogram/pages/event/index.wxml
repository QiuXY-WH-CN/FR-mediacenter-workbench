<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot {{item.edge ? 'edge-dot edge-' + item.side : 'center-dot'}}" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;opacity:{{item.opacity || 1}};"/></view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ event }}"><view class="eyebrow">{{event.type || ui.s235}} · {{event.source || ui.s193}}</view><view class="title">{{event.name}}</view><view>{{event.dateLabel}}</view><view class="muted">至 {{event.endDate || event.date}} {{event.endTime}}</view><view class="muted">{{event.location || '地点待定'}}</view><view class="card"><view class="h3">{{ui.s338}}</view><view class="pre">{{event.description || '暂无补充说明'}}</view><view class="muted">对接人：{{event.requester || '未填写'}}</view></view><view class="card"><view class="h3">{{ui.s339}}</view><view class="muted">{{event.cloudUrl ? '复制链接，到云盘客户端或浏览器上传。' : '负责人可稍后补充云盘上传链接。'}}</view><button wx:if="event.cloudUrl" class="secondary safe-button" bindtap="copy">{{ui.s340}}</button><view class="reward">新任务默认 {{event.rewardPoints || 0}} 积分 · {{event.rewardNote}}</view></view><view wx:if="event.canEdit" class="actions"><button bindtap="reschedule">{{ui.s341}}</button><button class="primary" data-url="/pages/editor/index?mode=task-new&event={{event.id}}" bindtap="go">{{ui.s393}}</button><button data-url="/pages/editor/index?mode=template-from&event={{event.id}}" bindtap="go">{{ui.s151}}</button></view><view class="h2 section-title">{{ui.s342}}</view><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="h3 grow">{{item.name}}</view><text class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.ownerName}} → {{item.receiverName}}</view><view class="muted">{{item.dueLabel}}</view><view class="reward">+{{item.rewardPoints || 0}} 积分</view></view><view wx:if="!tasks.length" class="empty">{{ui.s343}}</view></block><view wx:else class="empty">{{ui.s344}}</view></view>
</block>
