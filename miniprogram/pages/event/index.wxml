<view class="page"><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ event }}"><view class="eyebrow">{{event.type || '自由活动'}} · {{event.source || '学媒自有'}}</view><view class="title">{{event.name}}</view><view>{{event.dateLabel}}</view><view class="muted">至 {{event.endDate || event.date}} {{event.endTime}}</view><view class="muted">{{event.location || '地点待定'}}</view><view class="card"><view class="h3">活动说明</view><view class="pre">{{event.description || '暂无补充说明'}}</view><view class="muted">对接人：{{event.requester || '未填写'}}</view></view><view class="card"><view class="h3">活动素材库</view><view class="muted">{{event.cloudUrl ? '复制链接，到云盘客户端或浏览器上传。' : '负责人可稍后补充云盘上传链接。'}}</view><button wx:if="event.cloudUrl" class="secondary safe-button" bindtap="copy">复制云盘上传链接</button><view class="reward">新任务默认 {{event.rewardPoints || 0}} 积分 · {{event.rewardNote}}</view></view><view wx:if="event.canEdit" class="actions"><button bindtap="reschedule">编辑 / 改期</button><button class="primary" data-url="/pages/editor/index?mode=task-new&event={{event.id}}" bindtap="go">＋ 添加任务</button><button data-url="/pages/editor/index?mode=template-from&event={{event.id}}" bindtap="go">保存为模板</button></view><view class="h2 section-title">任务与交付</view><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="h3 grow">{{item.name}}</view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.ownerName}} → {{item.receiverName}}</view><view class="muted">{{item.dueLabel}}</view><view class="reward">+{{item.rewardPoints || 0}} 积分</view></view><view wx:if="!tasks.length" class="empty">这是一个空白日程，尚未分配任务。</view></block><view wx:else class="empty">活动不存在，或当前账号无查看权限。</view></view>
