.local-checks{padding:8rpx 24rpx}.local-check{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;min-height:50px;padding:24rpx 0;border-bottom:1rpx solid #eee}.local-check:last-child{border:0}.local-check-label{flex:1;min-width:0}.local-check-value{text-align:right;max-width:55%;overflow-wrap:anywhere;font-size:calc(25rpx * var(--font-scale,1));color:#777}.local-check-value.good{color:#187b62}.local-check-value.attention{color:#a45d22}.dark .local-check{border-color:#333}.dark .local-check-value.good{color:#6ad5b7}.dark .local-check-value.attention{color:#f3ba7c}.local-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.local-actions button{min-height:48px;padding:22rpx 18rpx}.local-actions .primary{grid-column:1/-1}.local-error{padding:22rpx 0;border-bottom:1rpx solid #eee;word-break:break-word}.dark .local-error{border-color:#333}.local-error:last-child{border:0}.local-error text{font-family:ui-monospace,monospace;font-size:calc(25rpx * var(--font-scale,1));color:var(--accent)}.local-privacy-note{margin-top:24rpx;line-height:1.8}.font-large .local-actions{grid-template-columns:1fr}.font-large .local-check{flex-wrap:wrap}.font-large .local-check-value{max-width:100%;text-align:left}
