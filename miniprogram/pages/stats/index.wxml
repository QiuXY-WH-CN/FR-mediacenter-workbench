<include src="../../templates/share-preview.wxml"/><block wx:if="{{!sharePreview}}">
<particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="stats" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/>
<view class="page stats-page {{fontScale > 1.12 ? 'font-large' : ''}} {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
 <view class="heading"><view class="title">{{l.title}}</view><view class="muted">{{l.period}}</view></view>
 <view wx:if="{{!allowed}}" class="card">{{l.forbidden}}</view>
 <block wx:else>
  <view class="muted intro">{{l.intro}}</view><view wx:if="{{syncError}}" class="error">{{syncError}}</view>
  <view class="stats-actions"><button size="mini" bindtap="reload" loading="{{loading}}">{{l.reload}}</button><button size="mini" data-action="repair" bindtap="maintain" disabled="{{readOnly || busy}}">{{l.repair}}</button></view>
  <view wx:if="{{ready}}" class="stats-cards"><view wx:for="{{cards}}" wx:key="label" class="card stat"><text>{{item.label}}</text><view>{{item.value}}</view></view></view>
  <view class="card"><view class="section-title">{{l.trend}}</view><scroll-view scroll-x><view class="chart"><view wx:for="{{days}}" wx:key="date" class="bar-item"><view class="bar-space"><view class="bar" style="height:{{item.height}}%"></view></view><text>{{item.date}}</text><text>{{item.hits}}</text></view></view></scroll-view><view wx:if="{{!days.length}}" class="muted">{{l.empty}}</view></view>
  <view class="card"><view class="section-title">{{l.map}}</view><canvas type="2d" id="stats-map" class="stats-map" wx:if="{{ready && !mapFallback}}"/><view wx:for="{{countries}}" wx:key="code" class="stats-row"><text>{{item.label}}</text><text>{{item.requests}} {{l.requests}} · {{item.pageviews}} {{l.views}}</text></view><view wx:if="{{!countries.length}}" class="muted">{{l.empty}}</view></view>
  <view class="card"><view class="section-title">{{l.networks}}</view><view wx:for="{{networks}}" wx:key="index" class="stats-row"><text class="network">{{item.network}}</text><text>{{item.requests}} · {{item.visitorDays}} {{l.visitors}}</text></view><view wx:if="{{!networks.length}}" class="muted">{{l.empty}}</view></view>
  <view class="card"><view class="section-title">{{l.risk}}</view><view wx:for="{{signals}}" wx:key="code" class="signal"><view>{{item.label}} · {{item.count}}</view><view class="muted">{{item.advice}}</view></view><view wx:if="{{!signals.length}}" class="muted">{{l.empty}}</view></view>
  <view class="card"><view class="section-title">{{l.logs}}</view><view class="stats-filters"><button size="mini" data-filter="all" bindtap="filter" class="{{filter === 'all' ? 'selected' : ''}}">{{l.all}}</button><button size="mini" data-filter="risk" bindtap="filter" class="{{filter === 'risk' ? 'selected' : ''}}">{{l.riskOnly}}</button><button size="mini" data-filter="error" bindtap="filter" class="{{filter === 'error' ? 'selected' : ''}}">{{l.errorOnly}}</button></view><view wx:for="{{visibleLogs}}" wx:key="index" class="log"><view class="stats-row"><text>{{item.label}}</text><text>{{item.status}} · {{item.duration}} ms</text></view><view class="muted">{{item.method}} · {{item.route}}</view><view class="muted">{{item.time}} · {{item.network}} · {{item.country}}</view></view><view wx:if="{{!visibleLogs.length}}" class="muted">{{l.empty}}</view></view>
  <view class="card muted">{{l.privacy}}</view><view class="muted intro">{{l.maintenance}}</view><button class="danger" data-action="clear" bindtap="maintain" disabled="{{readOnly || busy}}">{{l.clear}}</button>
 </block>
</view>
</block>
