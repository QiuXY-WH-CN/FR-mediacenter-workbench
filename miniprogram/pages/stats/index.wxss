.stats-page{padding-bottom:40px}.heading{display:flex;gap:12px;align-items:baseline;justify-content:space-between}.intro{margin:12px 0;line-height:1.7}.stats-actions,.stats-filters{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.stats-actions button,.stats-filters button{margin:0}.stats-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.stats-cards .card{margin:0 0 10px}.stat text{color:#747474;font-size:calc(12px * var(--font-scale,1))}.stat view{font-size:calc(25px * var(--font-scale,1));font-weight:700;margin-top:8px;overflow-wrap:anywhere}.section-title{font-size:calc(17px * var(--font-scale,1));font-weight:700;margin-bottom:12px}.stats-map{width:100%;height:175px}.stats-row{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid #ededed;font-size:calc(12px * var(--font-scale,1));overflow-wrap:anywhere}.stats-row text:last-child{text-align:right;color:#767676}.network{font-family:monospace;max-width:65%;overflow-wrap:anywhere}.signal,.log{padding:12px 0;border-bottom:1px solid #ededed;line-height:1.65;overflow-wrap:anywhere}.signal .muted,.log .muted{font-size:calc(12px * var(--font-scale,1));margin-top:5px}.chart{display:flex;gap:10px;min-width:100%;height:165px}.bar-item{width:32px;min-width:32px;text-align:center;font-size:10px;display:flex;flex-direction:column;gap:4px}.bar-space{height:120px;display:flex;align-items:flex-end;justify-content:center}.bar{width:20px;background:var(--accent);border-radius:6px 6px 0 0;min-height:2px}.selected{color:var(--accent)}.danger{color:#a63333;margin-top:12px}.dark .stats-row,.dark .signal,.dark .log{border-color:#343434}.dark .stat text,.dark .stats-row text:last-child{color:#b5b5b5}.error{padding:12px;color:#af3535}
