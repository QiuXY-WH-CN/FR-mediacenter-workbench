.person-trigger{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:88rpx;white-space:normal;word-break:break-word}.person-menu{max-height:65vh;overflow-y:auto}.person-choice,.person-dept{min-height:88rpx;box-sizing:border-box;display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.person-identity{flex:1;min-width:0;display:flex;align-items:baseline;gap:12rpx;flex-wrap:wrap;word-break:break-word}.person-role{color:#8d8d8d;font-size:.82em;font-weight:400}.selected-people{display:flex;flex-wrap:wrap;gap:12rpx;padding:12rpx 0}.selected-person{display:flex;align-items:baseline;gap:8rpx;flex-wrap:wrap;padding:8rpx 14rpx;background:var(--theme-soft);border-radius:16rpx;max-width:100%;word-break:break-word}.multi-choice checkbox{flex:none;pointer-events:none}.dark .person-role{color:#aaa}
