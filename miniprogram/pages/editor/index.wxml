<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="editor" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/><view class="title">{{title}}</view><view wx:if="{{error || syncError}}" class="error">{{error || syncError}}</view><view wx:if="{{ templateHint }}" class="hint">{{templateHint}}</view><view class="editor-fields"><view wx:for="{{fields}}" wx:for-item="field" wx:for-index="fieldIndex" wx:key="key" class="field" hidden="{{field.hidden}}"><view wx:if="{{field.sectionStart}}" class="editor-section">{{field.section}}</view><text user-select="{{false}}" selectable="{{false}}" class="label">{{field.label}}</text><view wx:if="{{field.type === 'multiPerson'}}" class="multi-person">
  <view class="picker person-trigger" data-index="{{fieldIndex}}" bindtap="togglePerson"><text>{{field.display}}</text><text>▾</text></view>
  <view wx:if="{{field.selectedPeople.length}}" class="selected-people"><view wx:for="{{field.selectedPeople}}" wx:for-item="choice" wx:key="value" class="selected-person"><text>{{choice.name}}</text><text class="person-role">{{choice.roleLabel}}</text></view></view>
  <view wx:if="{{field.open}}" class="person-menu">
    <view wx:for="{{field.options}}" wx:for-item="choice" wx:key="value" wx:if="{{!choice.dept}}" class="person-choice multi-choice" data-index="{{fieldIndex}}" data-value="{{choice.value}}" bindtap="togglePersonChoice"><checkbox checked="{{choice.checked}}" color="{{particleTheme}}"/><view class="person-identity"><text>{{choice.name}}</text><text class="person-role">{{choice.roleLabel}}</text></view></view>
    <view wx:for="{{field.groups}}" wx:for-item="group" wx:key="dept"><view class="person-dept" style="color:{{group.color}}" data-index="{{fieldIndex}}" data-dept="{{group.dept}}" bindtap="personDept">{{field.department === group.dept ? '▾' : '▸'}} {{group.dept}}</view><view wx:if="{{field.department === group.dept}}"><view wx:for="{{group.people}}" wx:for-item="choice" wx:key="value" class="person-choice multi-choice" data-index="{{fieldIndex}}" data-value="{{choice.value}}" bindtap="togglePersonChoice"><checkbox checked="{{choice.checked}}" color="{{particleTheme}}"/><view class="person-identity"><text>{{choice.name}}</text><text class="person-role">{{choice.roleLabel}}</text></view></view></view></view>
  </view>
</view><view wx:elif="{{field.type === 'person'}}"><view class="picker" data-index="{{fieldIndex}}" bindtap="togglePerson">{{field.display}} ▾</view><view wx:if="{{field.open}}" class="person-menu"><view wx:for="{{field.options}}" wx:for-item="choice" wx:key="value" wx:if="{{!choice.dept}}" class="person-choice" data-index="{{fieldIndex}}" data-value="{{choice.value}}" bindtap="selectPerson"><text>{{choice.label}}</text><text wx:if="{{choice.roleLabel}}" class="person-role">{{choice.roleLabel}}</text></view><view wx:for="{{field.groups}}" wx:for-item="group" wx:key="dept"><view class="person-dept" style="color:{{group.color}}" data-index="{{fieldIndex}}" data-dept="{{group.dept}}" bindtap="personDept">{{field.department === group.dept ? '▾' : '▸'}} {{group.dept}}</view><view wx:if="{{field.department === group.dept}}"><view wx:for="{{group.people}}" wx:for-item="choice" wx:key="value" class="person-choice" data-index="{{fieldIndex}}" data-value="{{choice.value}}" bindtap="selectPerson"><text>{{choice.label}}</text><text wx:if="{{choice.roleLabel}}" class="person-role">{{choice.roleLabel}}</text></view></view></view></view></view><picker wx:elif="{{field.type === 'select'}}" range="{{field.options}}" range-key="label" value="{{field.selected}}" data-index="{{fieldIndex}}" bindchange="change"><view class="picker">{{field.display}} ▾</view></picker><picker wx:elif="{{field.type === 'date' || field.type === 'time'}}" mode="{{field.type}}" value="{{field.value}}" data-index="{{fieldIndex}}" bindchange="change"><view class="picker">{{field.value}}</view></picker><switch wx:elif="{{field.type === 'switch'}}" checked="{{field.value}}" color="#f58220" data-index="{{fieldIndex}}" bindchange="change"/><textarea wx:elif="{{field.type === 'textarea'}}" value="{{field.value}}" data-index="{{fieldIndex}}" bindinput="change" maxlength="3000" cursor-spacing="100"/><checkbox-group wx:elif="{{field.type === 'checks'}}" data-index="{{fieldIndex}}" bindchange="change"><label wx:for="{{field.options}}" wx:for-item="choice" wx:key="value" class="check"><checkbox value="{{choice.value}}" checked="{{choice.checked}}" color="{{particleTheme}}"/>{{choice.label}}</label></checkbox-group><input wx:else value="{{field.value}}" type="{{field.type === 'number' ? 'number' : 'text'}}" password="{{field.type === 'password'}}" data-index="{{fieldIndex}}" bindinput="change" maxlength="2000" cursor-spacing="100" confirm-type="done"/></view></view><view wx:if="{{ isTemplate }}" class="actions"><button bindtap="addStep">{{ui.s331}}</button><button bindtap="removeStep">{{ui.s332}}</button></view><view wx:if="{{ isTemplate }}" class="hint">{{ui.s333}}</view><view class="card" wx:if="{{ resultToken }}"><view class="h3">{{tokenLabel}}</view><view class="pre small">{{resultToken}}</view><view class="actions"><button bindtap="copy">{{ui.s334}}</button><button wx:if="{{!isMember}}" open-type="share">{{shareLabel}}</button></view></view><button wx:if="{{ isMember }}" bindtap="resetMember" class="safe-button" disabled="{{busy}}">{{ui.s336}}</button><view class="fixed-actions"><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">{{ui.s337}}</button></view></view>
</block>
