<view class="page"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">{{ui.s139}}</view><view class="hint">{{ui.s320}}</view><view class="conn-options"><view class="conn-option {{mode === 0 ? 'selected' : ''}}" data-mode="0" bindtap="choose"><view class="h3">{{ui.s321}}</view><view class="muted">{{ui.s322}}</view></view><view class="conn-option {{mode === 1 ? 'selected' : ''}}" data-mode="1" bindtap="choose"><view class="h3">{{ui.s323}}</view><view class="muted">{{ui.s324}}</view></view></view><view class="field" wx:if="mode === 0"><text class="label">{{ui.s325}}</text><input value="{{directBaseUrl}}" data-key="directBaseUrl" bindinput="input" placeholder="http://127.0.0.1:8766"/><view class="muted">{{ui.s326}}</view></view><view class="field" wx:else><text class="label">{{ui.s327}}</text><input value="{{cloudEnv}}" data-key="cloudEnv" bindinput="input" placeholder="例如 cloud1-xxxxxx"/><view class="muted">{{ui.s328}}</view></view><view wx:if="{{ message }}" class="hint">{{message}}</view><view class="actions"><button loading="{{testing}}" disabled="{{testing}}" bindtap="test">{{ui.s329}}</button><button class="primary" bindtap="save">{{ui.s330}}</button></view></view>
