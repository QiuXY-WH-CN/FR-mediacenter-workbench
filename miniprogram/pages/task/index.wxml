<view class="page"><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ task }}"><text class="badge {{task.status}}">{{task.statusLabel}}</text><view class="title">{{task.name}}</view><view class="muted">{{task.eventName}}</view><view class="muted">{{task.ownerName}} → {{task.receiverName}}</view><view class="muted">截止 {{task.dueLabel}}</view><view class="reward">{{task.rewardPoints || 0}} 积分 · {{task.rewardNote}}</view><view wx:if="task.feedback" class="hint">反馈：{{task.feedback}}</view><view class="card"><view class="h3">交付要求</view><view class="pre">{{task.requirements}}</view><button wx:if="event.cloudUrl" class="secondary safe-button" bindtap="cloud">复制活动云盘上传链接</button></view><block wx:if="{{ submitting }}"><view class="card"><view class="h2">提交前核对</view><checkbox-group bindchange="checks"><view wx:for="{{task.checks}}" wx:key="index"><label class="check"><checkbox value="{{index}}" color="#f58220"/>{{item}}</label><view class="link small" data-index="{{index}}" bindtap="help" bindlongpress="help">查看要求 · 可长按</view></view></checkbox-group></view><view class="field"><text class="label">成果与交接说明</text><textarea data-key="submission" value="{{submission}}" bindinput="input" maxlength="3000"/></view><view wx:if="event.cloudUrl" class="card"><view class="h3">活动素材库上传确认</view><button bindtap="cloud">复制上传地址</button><view class="muted">在云盘完成上传后返回确认，验收人会核实实际文件。</view><checkbox-group data-key="uploadConfirmed" bindchange="confirm"><label class="check"><checkbox value="yes" checked="{{uploadConfirmed}}" disabled="{{!uploadVisited}}" color="#f58220"/>已上传，且验收人有访问权限</label></checkbox-group></view><view class="field"><text class="label">个人成果链接（可选）</text><input data-key="link" value="{{link}}" bindinput="input" maxlength="2000" placeholder="https://…"/></view><block wx:if="{{ link }}"><button bindtap="copyLink">复制成果链接核对</button><checkbox-group data-key="linkConfirmed" bindchange="confirm"><label class="check"><checkbox value="yes" checked="{{linkConfirmed}}" color="#f58220"/>已核对链接和访问权限</label></checkbox-group></block><view class="actions fixed-actions"><button bindtap="cancel">取消</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="send">提交成果</button></view></block><block wx:elif="{{ feedbackMode }}"><view class="field"><text class="label">{{feedbackMode === 'conflict' ? '时间冲突说明' : '修改意见'}}</text><textarea data-key="feedback" value="{{feedback}}" bindinput="input" maxlength="1000"/></view><view class="actions"><button bindtap="cancel">取消</button><button class="primary" disabled="{{busy}}" bindtap="sendFeedback">确认提交</button></view></block><block wx:else><view wx:if="task.submission" class="card"><view class="h3">已提交成果</view><view class="pre">{{task.submission}}</view><button wx:if="task.link" bindtap="copyLink">复制个人成果链接</button><button wx:if="task.uploadReceipt" bindtap="receipt">复制提交时上传位置</button></view><view class="actions"><button wx:if="{{ canAccept }}" class="primary" data-action="accept" bindtap="doAction" disabled="{{busy}}">接受任务</button><button wx:if="{{ canResume }}" class="primary" data-action="resume" bindtap="doAction" disabled="{{busy}}">冲突解决，恢复接活</button><button wx:if="{{ canSubmit }}" class="primary" bindtap="startSubmit">提交成果</button><button wx:if="{{ canConflict }}" data-action="conflict" bindtap="feedback">时间冲突</button><button wx:if="{{ canReview }}" class="primary" data-action="approve" bindtap="doAction" disabled="{{busy}}">验收通过</button><button wx:if="{{ canReview }}" data-action="reject" bindtap="feedback">要求修改</button><button wx:if="task.canEdit && task.status !== 'done'" data-url="/pages/editor/index?mode=task-edit&id={{task.id}}" bindtap="go">调整分工与奖励</button></view></block></block><view wx:else class="empty">任务不存在，或当前账号无权限。</view></view>
