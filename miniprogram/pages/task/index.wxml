<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot {{item.edge ? 'edge-dot edge-' + item.side : 'center-dot'}}" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;opacity:{{item.opacity || 1}};"/></view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ task }}"><text class="badge {{task.status}}">{{task.statusLabel}}</text><text class="priority {{task.priority}}">{{task.priorityLabel}}{{ui.s98}}</text><view class="title">{{task.name}}</view><view class="muted">{{task.eventName}}</view><view class="muted">{{task.ownerName}} → {{task.receiverName}}</view><view class="muted">截止 {{task.dueLabel}}</view><view class="reward">{{task.rewardPoints || 0}} 积分 · {{task.rewardNote}}</view><view wx:if="task.feedback" class="hint">反馈：{{task.feedback}}</view><view class="card"><view class="h3">{{ui.s177}}</view><view class="pre">{{task.requirements}}</view><button wx:if="event.cloudUrl" class="secondary safe-button" bindtap="cloud">{{ui.s359}}</button></view><block wx:if="{{ submitting }}"><view class="card"><view class="h2">{{ui.s360}}</view><checkbox-group bindchange="checks"><view wx:for="{{task.checks}}" wx:key="index"><label class="check"><checkbox value="{{index}}" color="#f58220"/>{{item}}</label><view class="link small" data-index="{{index}}" bindtap="help" bindlongpress="help">{{ui.s361}}</view></view></checkbox-group></view><view class="field"><text class="label">{{ui.s362}}</text><textarea data-key="submission" value="{{submission}}" bindinput="input" maxlength="3000"/></view><view wx:if="event.cloudUrl" class="card"><view class="h3">{{ui.s363}}</view><button bindtap="cloud">{{ui.s364}}</button><view class="muted">{{ui.s365}}</view><checkbox-group data-key="uploadConfirmed" bindchange="confirm"><label class="check"><checkbox value="yes" checked="{{uploadConfirmed}}" disabled="{{!uploadVisited}}" color="#f58220"/>{{ui.s366}}</label></checkbox-group></view><view class="field"><text class="label">{{ui.s367}}</text><input data-key="link" value="{{link}}" bindinput="input" maxlength="2000" placeholder="https://…"/></view><block wx:if="{{ link }}"><button bindtap="copyLink">{{ui.s368}}</button><checkbox-group data-key="linkConfirmed" bindchange="confirm"><label class="check"><checkbox value="yes" checked="{{linkConfirmed}}" color="#f58220"/>{{ui.s369}}</label></checkbox-group></block><view class="actions fixed-actions"><button bindtap="cancel">{{ui.s219}}</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="send">{{ui.s209}}</button></view></block><block wx:elif="{{ feedbackMode }}"><view class="field"><text class="label">{{feedbackMode === 'conflict' ? '时间冲突说明' : '修改意见'}}</text><textarea data-key="feedback" value="{{feedback}}" bindinput="input" maxlength="1000"/></view><view class="actions"><button bindtap="cancel">{{ui.s219}}</button><button class="primary" disabled="{{busy}}" bindtap="sendFeedback">{{ui.s402}}</button></view></block><block wx:else><view wx:if="task.submission" class="card"><view class="h3">{{ui.s370}}</view><view class="pre">{{task.submission}}</view><button wx:if="task.link" bindtap="copyLink">{{ui.s371}}</button><button wx:if="task.uploadReceipt" bindtap="receipt">{{ui.s372}}</button></view><view class="actions"><button wx:if="{{ canAccept }}" class="primary" data-action="accept" bindtap="doAction" disabled="{{busy}}">{{ui.s208}}</button><button wx:if="{{ canResume }}" class="primary" data-action="resume" bindtap="doAction" disabled="{{busy}}">{{ui.s373}}</button><button wx:if="{{ canSubmit }}" class="primary" bindtap="startSubmit">{{ui.s209}}</button><button wx:if="{{ canConflict }}" data-action="conflict" bindtap="feedback">{{ui.s109}}</button><button wx:if="{{ canReview }}" class="primary" data-action="approve" bindtap="doAction" disabled="{{busy}}">{{ui.s211}}</button><button wx:if="{{ canReview }}" data-action="reject" bindtap="feedback">{{ui.s212}}</button><button wx:if="task.canEdit && task.status !== 'done'" data-url="/pages/editor/index?mode=task-edit&id={{task.id}}" bindtap="go">{{ui.s374}}</button></view></block></block><view wx:else class="empty">{{ui.s375}}</view></view>
</block>
