.profile-identity{display:flex;gap:26rpx;align-items:center}.profile-identity .title{font-size:38rpx;margin:0 0 6rpx;word-break:break-word}.profile-identity .link{margin-top:16rpx}.profile-avatar,.profile-placeholder{width:126rpx;height:126rpx;flex-shrink:0}.profile-placeholder{display:flex;align-items:center;justify-content:center;border-radius:50%;background:#eee;color:var(--accent);font-size:24rpx;padding:14rpx;text-align:center;overflow:hidden;word-break:break-word}.dark .profile-placeholder{background:#303030}.profile-points{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.profile-points .points{font-size:56rpx}.profile-menu{padding:8rpx 26rpx}.profile-menu .menu:last-child{border-bottom:0}.profile-share{width:100%;border-radius:0;border-width:0 0 1rpx;border-color:#eee5dc;background:transparent;text-align:left;line-height:1.6;padding:24rpx 0;font-size:30rpx}.dark .profile-share{background:transparent}.profile-account-actions{margin-top:24rpx}.profile-note{margin-top:24rpx}.profile-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
