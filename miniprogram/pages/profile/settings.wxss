.avatar-output-canvas{position:fixed;left:-2000px;top:0;width:256px;height:256px;pointer-events:none}.avatar-crop-backdrop{position:fixed;left:0;top:0;width:100%;height:100%;background:#0009;z-index:80;display:flex;align-items:center;justify-content:center;padding:24rpx}.avatar-crop-sheet{width:100%;max-width:650rpx;max-height:calc(100vh - 48rpx);overflow-y:auto;padding:28rpx;border-radius:30rpx;background:#fff;box-shadow:0 24rpx 80rpx #0004}.dark .avatar-crop-sheet{background:#191919}.avatar-crop-hint{margin:12rpx 0 22rpx;line-height:1.6}.avatar-crop-stage{position:relative;width:100%;max-width:520rpx;aspect-ratio:1;margin:0 auto;background:#303030;border-radius:20rpx;overflow:hidden}.avatar-crop-stage:before{content:'';display:block;padding-top:100%}.avatar-crop-canvas{position:absolute;left:0;top:0;width:100%;height:100%}.avatar-circle-mask{position:absolute;left:0;top:0;width:100%;height:100%;border:3rpx solid #fff;border-radius:50%;box-shadow:0 0 0 180rpx #0008;pointer-events:none}.avatar-preview-label{text-align:center;font-size:calc(23rpx * var(--font-scale,1));color:#777;margin:14rpx 0 22rpx}.avatar-reset{background:transparent;border:0;color:var(--accent);font-size:calc(26rpx * var(--font-scale,1));margin-bottom:14rpx}.avatar-crop-sheet .actions{margin-top:14rpx}.avatar-crop-sheet .actions button{min-height:44px}.avatar-crop-backdrop .row{flex-wrap:nowrap}.font-large .avatar-crop-sheet{max-height:90vh}.font-large .avatar-crop-stage{max-width:440rpx}
