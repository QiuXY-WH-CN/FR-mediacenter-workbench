<view class="page"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><canvas id="avatar-canvas" type="2d" style="position:fixed;left:-200px;top:0;width:112px;height:112px;pointer-events:none"/><view class="title">个人资料</view><view class="hint">改名与头像修改须经管理员批准。审核期间保留当前资料。</view><view class="field"><text class="label">姓名</text><input value="{{name}}" bindinput="name" maxlength="30"/></view><view class="card"><image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}"/><view class="actions"><button bindtap="chooseAvatar" disabled="{{busy}}">选择头像</button><button bindtap="clearAvatar">移除头像</button></view></view><view wx:if="{{profile.review_status==='pending'}}" class="hint">待审核姓名：{{profile.pending_name}}。再次提交会替换原申请。</view><view wx:if="{{profile.review_status==='rejected'}}" class="error">申请已退回：{{profile.review_note || '请修改后重新提交'}}</view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">提交管理员审核</button></view>