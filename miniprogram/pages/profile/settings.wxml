<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><canvas id="avatar-canvas" type="2d" style="position:fixed;left:-200px;top:0;width:112px;height:112px;pointer-events:none"/><view class="title">{{ui.s30}}</view><view class="hint">{{ui.s351}}</view><view class="field"><text class="label">{{ui.s35}}</text><input value="{{name}}" bindinput="name" maxlength="30"/></view><view class="card"><image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}"/><view class="actions"><button bindtap="chooseAvatar" disabled="{{busy}}">{{ui.s352}}</button><button bindtap="clearAvatar">{{ui.s52}}</button></view></view><view wx:if="{{profile.review_status==='pending'}}" class="hint">{{ui.s399}}{{profile.pending_name}}。再次提交会替换原申请。</view><view wx:if="{{profile.review_status==='rejected'}}" class="error">{{ui.s400}}{{profile.review_note || '请修改后重新提交'}}</view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{ui.s401}}</button><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
