<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><canvas id="avatar-canvas" type="2d" style="position:fixed;left:-200px;top:0;width:112px;height:112px;pointer-events:none"/><view class="title">{{ui.s30}}</view><view class="hint">{{ui.s351}}</view><view class="field"><text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s35}}</text><input value="{{name}}" bindinput="name" maxlength="30"/></view><view class="card"><image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}"/><view class="actions"><button bindtap="chooseAvatar" disabled="{{busy}}">{{ui.s352}}</button><button bindtap="clearAvatar">{{ui.s52}}</button></view></view><view wx:if="{{profile.review_status==='pending'}}" class="hint">{{ui.s399}}{{profile.pending_name}}。再次提交会替换原申请。</view><view wx:if="{{profile.review_status==='rejected'}}" class="error">{{ui.s400}}{{profile.review_note || '请修改后重新提交'}}</view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{ui.s401}}</button></view>
</block>
