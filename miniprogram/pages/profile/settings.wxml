<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
 <particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/>
 <canvas id="avatar-output-canvas" type="2d" class="avatar-output-canvas"/>
 <view class="title">{{ui.s30}}</view><view class="hint">{{ui.s351}}</view>
 <view class="field"><text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s35}}</text><input value="{{name}}" bindinput="name" maxlength="30"/></view>
 <view class="card"><image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}" mode="aspectFill"/><view class="actions"><button bindtap="chooseAvatar" disabled="{{busy}}">{{ui.s352}}</button><button bindtap="clearAvatar">{{ui.s52}}</button></view></view>
 <view wx:if="{{profile.review_status === 'pending'}}" class="hint">{{ui.s399}}{{profile.pending_name}}。再次提交会替换原申请。</view><view wx:if="{{profile.review_status === 'rejected'}}" class="error">{{ui.s400}}{{profile.review_note || '请修改后重新提交'}}</view>
 <button class="primary" bindtap="save" disabled="{{busy || cropping}}" loading="{{busy}}">{{ui.s401}}</button>
 <view wx:if="{{cropping}}" class="avatar-crop-backdrop" catchtouchmove="cropBackdropMove"><view class="avatar-crop-sheet"><view class="h2">{{cropLabels.title}}</view><view class="muted small avatar-crop-hint">{{cropLabels.hint}}</view><view class="avatar-crop-stage" catchtouchstart="cropTouchStart" catchtouchmove="cropTouchMove" catchtouchend="cropTouchEnd" catchtouchcancel="cropTouchEnd"><canvas id="avatar-crop-canvas" type="2d" class="avatar-crop-canvas"/><view class="avatar-circle-mask"/></view><view class="avatar-preview-label">{{cropLabels.preview}}</view><view class="row"><view>{{cropLabels.zoom}}</view><view class="muted">{{zoom}}%</view></view><slider min="100" max="400" step="5" value="{{zoom}}" bindchanging="cropZoom" bindchange="cropZoom" activeColor="{{particleTheme}}"/><button class="avatar-reset" bindtap="resetCrop">{{cropLabels.reset}}</button><view class="actions"><button bindtap="closeCrop" disabled="{{cropSaving}}">{{cropLabels.cancel}}</button><button class="primary" bindtap="applyCrop" loading="{{cropSaving}}" disabled="{{cropSaving}}">{{cropLabels.apply}}</button></view></view></view>
</view>
</block>
