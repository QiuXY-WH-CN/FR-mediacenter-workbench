<view class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}" style="{{themeStyle}}">
 <view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view>
 <view class="title">{{ui.s28}}</view><view class="tabs"><view class="tab {{tab === 'general' ? 'selected' : ''}}" data-id="general" bindtap="tab">{{ui.s25}}</view><view class="tab {{tab === 'appearance' ? 'selected' : ''}}" data-id="appearance" bindtap="tab">{{ui.s26}}</view><view class="tab {{tab === 'account' ? 'selected' : ''}}" data-id="account" bindtap="tab">{{ui.s27}}</view></view>
 <block wx:if="{{tab === 'general'}}"><view class="card"><view class="label">{{ui.s54}}</view><picker range="{{languageLabels}}" value="{{languageIndex}}" bindchange="languageChange"><view class="picker">{{languageLabels[languageIndex]}}</view></picker><view class="muted small">{{ui.s57}}</view><view class="row space"><text>{{ui.s58}}</text><switch checked="{{settings.compact}}" data-key="compact" bindchange="toggle"/></view></view><button bindtap="clearCache">{{ui.s60}}</button><view class="muted small">{{ui.s62}}</view></block>
 <block wx:if="{{tab === 'appearance'}}"><view class="card"><view class="h2">{{ui.s64}}</view><view class="actions"><view wx:for="{{colors}}" wx:key="*this" data-color="{{item}}" bindtap="color" style="background:{{item}};width:60rpx;height:60rpx;border-radius:50%;border:{{settings.themeColor === item ? '6rpx solid #888' : 'none'}}"/></view><input class="space" value="{{settings.themeColor}}" data-key="themeColor" bindinput="input" placeholder="#RRGGBB"/><view class="field"><view class="label">{{ui.s65}}</view><picker range="{{appearanceLabels}}" value="{{appearanceIndex}}" bindchange="appearance"><view class="picker">{{appearanceLabels[appearanceIndex]}}</view></picker></view></view>
 <view class="card"><view class="h2">{{ui.s71}}</view><view class="field"><view class="label">{{ui.s72}}</view><picker range="{{styles}}" value="{{particleIndex}}" bindchange="particle"><view class="picker">{{styles[particleIndex]}}</view></picker></view><block wx:if="{{settings.particles !== 'off'}}"><view class="label">{{ui.s73}}</view><slider min="10" max="80" value="{{settings.particleDensity || 48}}" data-key="particleDensity" bindchange="input" show-value/><view wx:if="{{settings.particles === 'rotate'}}" class="field"><view class="label">{{ui.s75}}</view><input type="number" value="{{settings.rotationMinutes || 5}}" data-key="rotationMinutes" bindinput="input"/></view></block><view class="row"><text>{{ui.s76}}</text><switch checked="{{settings.motion !== false}}" data-key="motion" bindchange="toggle"/></view><view class="row space"><text>{{ui.s77}}</text><switch checked="{{settings.respectSystemMotion}}" data-key="respectSystemMotion" bindchange="toggle"/></view></view></block>
 <button wx:if="{{tab !== 'account'}}" class="primary space" bindtap="save" disabled="{{busy}}">{{ui.s89}}</button>
 <block wx:if="{{tab === 'account'}}"><view class="menu" data-url="/pages/profile/settings" bindtap="go">{{ui.s396}}</view><view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">{{ui.s397}}</view><button class="space" bindtap="logout">{{ui.s45}}</button><view class="card"><view class="h2">{{ui.s252}}</view><block wx:if="{{request.status === 'pending'}}"><view class="hint">{{ui.s258}}</view><button bindtap="cancelClosure">{{ui.s256}}</button></block><block wx:else><textarea class="space" value="{{reason}}" bindinput="reason" maxlength="500" placeholder="{{ui.s254}}"/><input class="space" value="{{password}}" password bindinput="password" placeholder="{{ui.s40}}"/><button class="danger space" bindtap="requestClosure" disabled="{{busy}}">{{ui.s255}}</button></block></view></block>
 <view class="muted small space">{{ui.s398}}</view>
<view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
