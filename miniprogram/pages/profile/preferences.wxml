<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page settings-page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
 <particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{settings.themeColor}}" rotation="{{rotationMinutes}}"/>
 <view class="title">{{ui.s28}}</view>
 <view class="tabs settings-tabs"><view class="tab {{tab === 'general' ? 'selected' : ''}}" data-id="general" bindtap="tab">{{ui.s25}}</view><view class="tab {{tab === 'appearance' ? 'selected' : ''}}" data-id="appearance" bindtap="tab">{{ui.s26}}</view><view class="tab {{tab === 'security' ? 'selected' : ''}}" data-id="security" bindtap="tab">{{l.security}}</view><view class="tab {{tab === 'account' ? 'selected' : ''}}" data-id="account" bindtap="tab">{{ui.s27}}</view></view>
 <block wx:if="{{tab === 'general'}}">
  <view class="card"><view class="label">{{ui.s54}}</view><picker range="{{languageLabels}}" value="{{languageIndex}}" bindchange="languageChange"><view class="picker">{{languageLabels[languageIndex]}} <text user-select="{{false}}" selectable="{{false}}">⌄</text></view></picker><view class="muted small setting-note">{{ui.s57}}</view></view>
  <view class="card"><view class="row"><view class="h2">{{l.font}}</view><view class="setting-value">{{fontPercent}}%</view></view><slider min="85" max="135" step="5" value="{{fontPercent}}" activeColor="{{settings.themeColor}}" bindchanging="font" bindchange="font"/><view class="font-preview"><view class="h3">{{l.fontSample}}</view><view class="muted">{{l.fontHint}}</view></view></view>
  <button bindtap="clearCache">{{ui.s60}}</button><view class="muted small setting-note">{{ui.s62}}</view>
 </block>
 <block wx:if="{{tab === 'appearance'}}">
  <view class="card"><view class="h2">{{ui.s64}}</view><view class="theme-swatches"><view wx:for="{{colors}}" wx:key="*this" data-color="{{item}}" bindtap="color" class="theme-swatch {{settings.themeColor === item ? 'selected' : ''}}" style="--swatch:{{item}};"/></view><input value="{{settings.themeColor}}" data-key="themeColor" bindinput="input" maxlength="7" placeholder="#RRGGBB"/><view class="field"><view class="label">{{ui.s65}}</view><picker range="{{appearanceLabels}}" value="{{appearanceIndex}}" bindchange="appearance"><view class="picker">{{appearanceLabels[appearanceIndex]}} <text user-select="{{false}}" selectable="{{false}}">⌄</text></view></picker></view>
   <view class="setting-switch"><view class="grow">{{l.on}}</view><switch checked="{{settings.motion !== false}}" data-key="motion" bindchange="toggle" color="{{settings.themeColor}}"/></view><view wx:if="{{settings.motion === false}}" class="muted small setting-note">{{l.disabled}}</view>
  </view>
  <view class="card particle-studio"><view class="h2">{{l.particles}}</view><view class="muted small setting-note">{{l.saveHint}}</view><view class="field"><view class="label">{{ui.s72}}</view><picker range="{{styles}}" value="{{particleIndex}}" bindchange="particle"><view class="picker">{{styles[particleIndex]}} <text user-select="{{false}}" selectable="{{false}}">⌄</text></view></picker></view>
   <block wx:if="{{settings.particles !== 'off'}}">
    <view class="label">{{ui.s73}} <text user-select="{{false}}" selectable="{{false}}" class="setting-value">{{settings.particleDensity || 48}}</text></view><slider min="10" max="80" value="{{settings.particleDensity || 48}}" data-key="particleDensity" bindchange="input" activeColor="{{settings.themeColor}}"/>
    <view wx:if="{{settings.particles === 'rotate'}}" class="field"><view class="label">{{ui.s75}}</view><input type="number" value="{{settings.rotationMinutes || 5}}" data-key="rotationMinutes" bindinput="input"/></view>
    <view class="label">{{l.preset}}</view><view class="particle-presets"><view wx:for="{{presetSwatches}}" wx:key="key" class="particle-preset {{settings.particleSystem.preset === item.key ? 'selected' : ''}}" data-preset="{{item.key}}" bindtap="preset"><view class="preset-gradient" style="background:linear-gradient(120deg,{{item.start}},{{item.end}});"/><view>{{item.label}}</view></view></view>
    <view class="physics-tabs"><view class="physics-tab {{physicsTab === 'movement' ? 'selected' : ''}}" data-id="movement" bindtap="physicsTab">{{l.movement}}</view><view class="physics-tab {{physicsTab === 'interaction' ? 'selected' : ''}}" data-id="interaction" bindtap="physicsTab">{{l.interaction}}</view><view class="physics-tab {{physicsTab === 'light' ? 'selected' : ''}}" data-id="light" bindtap="physicsTab">{{l.light}}</view></view>
    <view wx:if="{{physicsTab === 'movement'}}" class="setting-switch"><view class="grow">{{l.collision}}</view><switch checked="{{settings.particleSystem.collision}}" data-key="collision" bindchange="systemToggle" color="{{settings.themeColor}}"/></view>
    <view wx:if="{{physicsTab === 'interaction'}}" class="field"><view class="label">{{l.pointer}}</view><picker range="{{interactionLabels}}" value="{{interactionIndex}}" bindchange="interaction"><view class="picker">{{interactionLabels[interactionIndex]}} <text user-select="{{false}}" selectable="{{false}}">⌄</text></view></picker></view>
    <block wx:if="{{physicsTab === 'light'}}"><view class="field"><view class="label">{{l.mode}}</view><picker range="{{colorLabels}}" value="{{colorIndex}}" bindchange="colorMode"><view class="picker">{{colorLabels[colorIndex]}} <text user-select="{{false}}" selectable="{{false}}">⌄</text></view></picker></view><block wx:if="{{settings.particleSystem.colorMode === 'gradient' || settings.particleSystem.colorMode === 'custom'}}"><view class="field"><view class="label">{{l.start}}</view><input value="{{settings.particleSystem.colorStart}}" data-key="colorStart" bindinput="systemInput" maxlength="7" placeholder="#66d9c5"/></view><view wx:if="{{settings.particleSystem.colorMode === 'gradient'}}" class="field"><view class="label">{{l.end}}</view><input value="{{settings.particleSystem.colorEnd}}" data-key="colorEnd" bindinput="systemInput" maxlength="7" placeholder="#a38cff"/></view><view class="gradient-preview" style="background:linear-gradient(90deg,{{particleSystem.colorStart}},{{particleSystem.colorEnd}});">{{l.gradient}}</view></block></block>
    <view wx:for="{{controls}}" wx:key="key" class="physics-control"><view class="row"><view class="grow">{{item.label}}</view><view class="setting-value">{{item.display}}</view></view><slider min="0" max="100" value="{{item.value}}" data-key="{{item.key}}" bindchange="control" activeColor="{{settings.themeColor}}"/></view>
   </block>
  </view>
 </block>
 <button wx:if="{{tab === 'general' || tab === 'appearance'}}" class="primary settings-save" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{ui.s89}}</button>
 <block wx:if="{{tab === 'security'}}"><view class="card"><view class="h2">{{l.security}}</view><view class="muted setting-note">{{l.securityInfo}}</view><button class="primary setting-note" data-url="/pages/security/index" bindtap="go">{{l.securityOpen}}</button></view></block>
 <block wx:if="{{tab === 'account'}}"><view class="menu" data-url="/pages/profile/settings" bindtap="go">{{ui.s396}} <text user-select="{{false}}" selectable="{{false}}">›</text></view><view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">{{ui.s397}} <text user-select="{{false}}" selectable="{{false}}">›</text></view><button class="setting-note" bindtap="logout">{{ui.s45}}</button><view class="card"><view class="h2">{{ui.s252}}</view><block wx:if="{{request.status === 'pending'}}"><view class="hint">{{ui.s258}}</view><button bindtap="cancelClosure">{{ui.s256}}</button></block><block wx:else><textarea class="setting-note" value="{{reason}}" bindinput="reason" maxlength="500" placeholder="{{ui.s254}}"/><input class="setting-note" value="{{password}}" password bindinput="password" placeholder="{{ui.s40}}"/><button class="danger setting-note" bindtap="requestClosure" disabled="{{busy}}">{{ui.s255}}</button></block></view></block>
 <view class="muted small setting-note">{{ui.s398}}</view>
</view>
</block>
