<view class="page {{dark ? 'dark' : ''}}" style="{{themeStyle}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">设置</view><view class="tabs"><view class="tab" data-id="general" bindtap="tab">通用外观</view><view class="tab" data-id="particles" bindtap="tab">动态背景</view><view class="tab" data-id="account" bindtap="tab">账号安全</view></view><block wx:if="{{tab === 'general'}}"><view class="card"><view class="h2">主题色</view><view class="actions"><view wx:for="{{colors}}" wx:key="*this" data-color="{{item}}" bindtap="color" style="background:{{item}};width:60rpx;height:60rpx;border-radius:50%;border:{{settings.themeColor === item ? '6rpx solid #333' : 'none'}}"/></view><input class="space" value="{{settings.themeColor}}" data-key="themeColor" bindinput="input" placeholder="#RRGGBB 自定义颜色"/><view class="field"><view class="label">显示模式</view><picker range="{{appearanceLabels}}" value="{{appearanceIndex}}" bindchange="appearance"><view class="picker">{{appearanceLabels[appearanceIndex]}}</view></picker></view><view class="row"><text>紧凑布局</text><switch checked="{{settings.compact}}" data-key="compact" bindchange="toggle"/></view></view><button bindtap="clearCache">清除本机缓存</button><view class="muted small">保留登录和连接配置；服务器任务不受影响。</view></block><block wx:if="{{tab === 'particles'}}"><view class="field"><view class="label">粒子样式</view><picker range="{{styles}}" value="{{particleIndex}}" bindchange="particle"><view class="picker">{{styles[particleIndex]}}</view></picker></view><view class="label">粒子数量</view><slider min="10" max="80" value="{{settings.particleDensity || 32}}" data-key="particleDensity" bindchange="input" show-value/><view class="field"><view class="label">轮换间隔（分钟，1—60）</view><input type="number" value="{{settings.rotationMinutes || 5}}" data-key="rotationMinutes" bindinput="input"/></view><view class="row"><text>开启动画</text><switch checked="{{settings.motion}}" data-key="motion" bindchange="toggle"/></view></block><button wx:if="{{tab !== 'account'}}" class="primary space" bindtap="save" disabled="{{busy}}">保存并同步各设备</button><block wx:if="{{tab === 'account'}}"><view class="menu" data-url="/pages/profile/settings" bindtap="go">更改姓名与头像 ›</view><view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">修改密码 ›</view><button class="space" bindtap="logout">更换账号 / 退出登录</button><view class="card"><view class="h2">注销账号申请</view><block wx:if="{{request.status === 'pending'}}"><view class="hint">正在等待管理员审核及工作交接。</view><button bindtap="cancelClosure">撤回申请</button></block><block wx:else><textarea class="space" value="{{reason}}" bindinput="reason" maxlength="500" placeholder="申请原因"/><input class="space" value="{{password}}" password bindinput="password" placeholder="当前密码"/><button class="danger space" bindtap="requestClosure" disabled="{{busy}}">提交注销申请</button></block></view></block><view class="muted small space">v1.0.1 · 设置在网页与 APP 同步</view></view>
