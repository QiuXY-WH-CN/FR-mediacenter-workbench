<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>{{ui.s53}}</view><image wx:if="{{user.avatar}}" class="profile-avatar" src="{{user.avatar}}"/><view class="title">{{user.name}}</view><view class="muted">{{user.dept}} · {{role}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" data-url="/pages/rewards/index" bindtap="go"><view class="muted">{{ui.s135}}</view><view class="points">{{points || 0}}</view><text class="link">{{ui.s395}}</text></view><view class="menu" data-url="/pages/events/index" bindtap="go">{{ui.s2}} <text>›</text></view><view class="menu" data-url="/pages/templates/index" bindtap="go">{{ui.s4}} <text>›</text></view><view class="menu" data-url="/pages/sop/index" bindtap="go">{{ui.s5}} <text>›</text></view><view class="menu" data-url="/pages/members/index" bindtap="go">{{ui.s8}} <text>›</text></view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s312}} <text>›</text></view><view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">{{ui.s43}} <text>›</text></view><view class="menu" wx:if="{{ cloud }}" bindtap="binding">{{bound ? ui.s477 : ui.s478}} <text>›</text></view><view class="menu" data-url="/pages/connection/index" bindtap="go">{{ui.s139}} <text>›</text></view><button class="safe-button" bindtap="logout" disabled="{{busy}}">{{ui.s48}}</button><view class="muted small space">{{ui.s349}}</view><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
