<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page profile-page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
 <particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="profile" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/>

 <view class="profile-identity card" data-url="/pages/profile/settings" bindtap="go">
  <image wx:if="{{user.avatar}}" class="profile-avatar" src="{{user.avatar}}" mode="aspectFill"/>
  <view wx:else class="profile-placeholder">{{user.name}}</view>
  <view class="grow"><view class="title">{{user.name}}</view><view class="muted small">@{{user.username}} · {{onlineLabel}}</view><view class="profile-affiliation"><view class="profile-department">{{departmentLabel}}</view><view class="profile-role">{{role}}</view></view><view class="link small">{{profileLabel}} ›</view></view>
 </view>
 <view wx:if="{{syncError}}" class="error">{{syncError}}</view>
 <view class="card profile-points" data-url="/pages/rewards/index" bindtap="go"><view><view class="muted">{{ui.s135}}</view><view class="points">{{points || 0}}</view></view><text user-select="{{false}}" selectable="{{false}}" class="link">{{ui.s395}}</text></view>
 <view class="card profile-menu">
  <view class="menu" data-url="/pages/security/index" bindtap="go">{{language === 'en' ? 'Local Safety Center' : '本机安全中心'}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" wx:if="{{user.role === 'admin'}}" data-url="/pages/stats/index" bindtap="go">{{language === 'en' ? 'Access statistics' : '访问统计'}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s312}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/profile/settings" bindtap="go">{{ui.s33}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">{{ui.s43}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" wx:if="{{cloud}}" bindtap="binding">{{bound ? ui.s477 : ui.s478}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <button class="menu profile-share" open-type="share">{{shareLabel}} <text user-select="{{false}}" selectable="{{false}}">↗</text></button>
 </view>
 <view class="card profile-menu">
  <view class="menu" data-url="/pages/events/index" bindtap="go">{{ui.s2}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/templates/index" bindtap="go">{{ui.s4}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/sop/index" bindtap="go">{{ui.s5}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/members/index" bindtap="go">{{ui.s8}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
  <view class="menu" data-url="/pages/connection/index" bindtap="go">{{ui.s139}} <text user-select="{{false}}" selectable="{{false}}">›</text></view>
 </view>
 <view class="actions profile-account-actions"><button bindtap="switchAccount" disabled="{{busy}}">{{ui.s44}}</button><button class="danger" bindtap="logout" disabled="{{busy}}">{{ui.s46}}</button></view>
 <view class="muted small profile-note">{{ui.s349}}</view>
</view>
</block>
