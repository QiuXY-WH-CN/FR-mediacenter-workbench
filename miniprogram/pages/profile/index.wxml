<view class="page"><view class="brand"><image class="logo" src="/images/emblem.png" mode="aspectFit"/>我的学媒</view><view class="title">{{user.name}}</view><view class="muted">{{user.dept}} · {{role}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" data-url="/pages/rewards/index" bindtap="go"><view class="muted">累计贡献积分</view><view class="points">{{points || 0}}</view><text class="link">查看积分记录 ›</text></view><view class="menu" data-url="/pages/events/index" bindtap="go">活动协作 <text>›</text></view><view class="menu" data-url="/pages/templates/index" bindtap="go">流程模板 <text>›</text></view><view class="menu" data-url="/pages/sop/index" bindtap="go">知识库 <text>›</text></view><view wx:if="{{ manager }}" class="menu" data-url="/pages/members/index" bindtap="go">成员与权限 <text>›</text></view><view class="menu" data-url="/pages/editor/index?mode=password" bindtap="go">修改密码 <text>›</text></view><view class="menu" wx:if="{{ cloud }}" bindtap="binding">{{bound ? '解除微信绑定' : '绑定当前微信，方便下次登录'}} <text>›</text></view><view class="menu" data-url="/pages/connection/index" bindtap="go">连接设置 <text>›</text></view><button class="safe-button" bindtap="logout" disabled="{{busy}}">退出当前设备</button><view class="muted small space">其他设备的登录不受本次退出影响。</view></view>

