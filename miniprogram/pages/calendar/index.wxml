<view class="page"><view class="title">日历与时间轴</view><view wx:if="syncError" class="error">{{syncError}}</view><view class="row"><button data-delta="-1" bindtap="month">‹</button><text class="h2">{{year}} 年 {{month}} 月</text><button data-delta="1" bindtap="month">›</button></view><view class="row field"><picker range="{{depts}}" value="{{deptIndex}}" bindchange="dept"><view class="picker">{{depts[deptIndex]}}</view></picker><text class="link" bindtap="today">今天</text></view><view class="cal"><view class="muted" wx:for="{{week}}" wx:key="*this">{{item}}</view></view><view class="cal"><view class="cell {{selected === item.id ? 'chosen' : ''}}" wx:for="{{cells}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><block wx:if="!item.empty"><view>{{item.number}}</view><view><text wx:if="item.events" class="dot"/><text wx:if="item.tasks" class="dot task-dot"/></view></block></view></view><view class="muted small">橙色：活动 · 红色：任务截止</view><view class="section-title h2">滑动时间轴</view><scroll-view scroll-x class="time-scroll" scroll-left="{{scrollLeft}}"><view class="time-track"><view wx:for="{{days}}" wx:key="id" class="time-day {{selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose">{{item.number}} 日<text class="time-count" wx:if="item.events">{{item.events}} 场活动</text><text class="small" wx:if="item.tasks">{{item.tasks}} 项截止</text></view></view></scroll-view><view class="h2">{{selected}}</view><view class="card" wx:for="{{selectedEvents}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><text class="tag">活动</text><view class="h3">{{item.name}}</view><view class="muted">{{item.dateLabel}} · {{item.location || '地点待定'}}</view></view><view class="card" wx:for="{{selectedTasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="h3 grow">{{item.name}}</view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.dueLabel}} · {{item.ownerName}}</view></view><view wx:if="!selectedEvents.length && !selectedTasks.length" class="empty">这一天暂无安排</view></view>
