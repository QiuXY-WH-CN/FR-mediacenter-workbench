<template name="calendar-child">
  <view class="calendar-child {{task.status === 'done' ? 'calendar-archived' : ''}} {{task.scheduleEnabled === false ? 'calendar-inactive' : ''}} {{task.dueToday ? 'calendar-due-today' : ''}}" data-id="{{task.id}}" bindtap="openTask">
    <view class="calendar-child-dot" style="background:{{task.departmentColor}};"/>
    <view class="grow">
      <view class="row start"><view class="h3 grow">{{task.name}}</view><text user-select="{{false}}" selectable="{{false}}" class="priority {{task.priority}}">{{task.priorityLabel}}{{ui.s98}}</text></view>
      <view class="calendar-task-info"><text user-select="{{false}}" selectable="{{false}}">{{task.ownerName}}</text><text user-select="{{false}}" selectable="{{false}}" class="badge {{task.status}}">{{task.statusLabel}}</text></view>
      <view class="muted small">{{task.departmentLabel}}<text wx:if="{{task.scheduleEnabled === false}}"> · {{task.scheduleLabel}}</text></view>
      <view class="calendar-due"><text user-select="{{false}}" selectable="{{false}}" wx:if="{{task.dueToday}}" class="calendar-due-tag">{{calendarLabels.dueToday}}</text><text user-select="{{false}}" selectable="{{false}}">{{task.dueLabel}}</text></view>
    </view>
    <text user-select="{{false}}" selectable="{{false}}" class="calendar-child-arrow">›</text>
  </view>
</template>
<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}} --dept-color:{{departmentColor}};" class="page department-calendar {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
  <particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="calendar" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/>
  <view class="title">{{ui.s3}}</view>
  <view wx:if="{{syncError}}" class="error">{{syncError}}</view>
  <view class="calendar-toolbar">
    <picker class="calendar-department" range="{{deptLabels}}" value="{{deptIndex}}" bindchange="dept"><view class="picker">{{deptLabels[deptIndex]}} ▾</view></picker>
    <button class="calendar-today" bindtap="today">{{ui.s241}}</button>
  </view>
  <view class="tabs calendar-mode"><view class="tab {{viewMode === item.id ? 'selected' : ''}}" wx:for="{{viewModes}}" wx:key="id" data-id="{{item.id}}" bindtap="mode">{{item.label}}</view></view>
  <view class="calendar-board">
    <view class="calendar-month row">
      <button class="calendar-arrow" data-delta="-1" bindtap="month" aria-label="{{calendarLabels.previousMonth}}">‹</button>
      <text user-select="{{false}}" selectable="{{false}}" class="h2">{{monthLabel}}</text>
      <button class="calendar-arrow" data-delta="1" bindtap="month" aria-label="{{calendarLabels.nextMonth}}">›</button>
    </view>
    <view class="calendar-summary"><text user-select="{{false}}" selectable="{{false}}">{{calendarLabels.monthEvents}} {{monthEventCount}}</text><text user-select="{{false}}" selectable="{{false}}">{{calendarLabels.monthTasks}} {{monthTaskCount}}</text></view>
    <block wx:if="{{viewMode === 'month'}}"><view class="calendar-week"><view wx:for="{{week}}" wx:key="*this">{{item}}</view></view>
    <view class="calendar-grid" bindtouchstart="touchStart" bindtouchend="touchEnd">
      <view wx:for="{{cells}}" wx:key="id" class="calendar-cell {{item.empty ? 'calendar-blank' : ''}} {{selected === item.id ? 'calendar-selected' : ''}} {{item.today ? 'calendar-is-today' : ''}} {{item.urgent ? 'calendar-urgent' : ''}} {{item.completed ? 'calendar-completed' : ''}} {{item.inactive ? 'calendar-inactive' : ''}}" data-id="{{item.id}}" bindtap="choose">
        <block wx:if="{{!item.empty}}">
          <view class="calendar-number">{{item.number}}</view>
          <view class="calendar-count" wx:if="{{item.tasks}}">{{item.tasks}}<text user-select="{{false}}" selectable="{{false}}" class="calendar-count-dot"/></view>
          <view class="calendar-event-dots" wx:elif="{{item.events}}"><text user-select="{{false}}" selectable="{{false}}"/><text user-select="{{false}}" selectable="{{false}}" wx:if="{{item.events > 1}}"/><text user-select="{{false}}" selectable="{{false}}" wx:if="{{item.events > 2}}"/></view>
          <view class="calendar-preview" wx:if="{{item.preview}}">{{item.preview}}</view>
        </block>
      </view>
    </view>
    </block>
    <scroll-view wx:else scroll-left="{{timelineScrollLeft}}" scroll-x="{{true}}" enable-flex="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="calendar-timeline-scroll"><view class="calendar-timeline" style="width:{{timelineWidth}}rpx;"><view class="timeline-axis"><view wx:for="{{days}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="timeline-date {{item.today ? 'timeline-today' : ''}} {{selected === item.id ? 'timeline-selected' : ''}}">{{item.number}}</view></view><view wx:if="{{showNowLine}}" class="timeline-now" style="left:{{nowLineLeft}}rpx;"><text>{{currentTime}}</text></view><view class="timeline-lane" wx:for="{{timelineRows}}" wx:key="id"><view data-id="{{item.id}}" bindtap="openEvent" class="timeline-caption {{item.phase}}" style="left:{{item.left}}rpx;"><view class="timeline-name">{{item.name}}</view><view class="timeline-meta">{{item.phaseLabel}} · {{item.tasks.length}} {{language === 'en' ? 'tasks' : '项任务'}}</view></view><view data-id="{{item.id}}" bindtap="openEvent" class="timeline-schedule {{item.phase}} {{item.scheduleEnabled === false ? 'timeline-inactive' : ''}}" style="left:{{item.left}}rpx;width:{{item.width}}rpx;--lane-color:{{item.departmentColor}};"/></view><view wx:if="{{!timelineRows.length}}" class="timeline-empty">{{timelineEmpty}}</view></view></scroll-view>
    <view wx:if="{{!monthHasSchedule}}" class="calendar-month-empty muted">{{calendarLabels.emptyMonth}}</view>
  </view>
  <view class="calendar-agenda-heading row">
    <button class="calendar-arrow" data-delta="-1" bindtap="shiftDay" aria-label="{{calendarLabels.previousDay}}">‹</button>
    <view class="grow"><view class="h2">{{selected}}</view><view class="muted small">{{ui.s342}}</view></view>
    <button class="calendar-arrow" data-delta="1" bindtap="shiftDay" aria-label="{{calendarLabels.nextDay}}">›</button>
  </view>
  <view class="calendar-project card {{group.scheduleEnabled === false ? 'calendar-inactive' : ''}}" wx:for="{{selectedGroups}}" wx:for-item="group" wx:key="id">
    <view class="calendar-project-heading row" data-id="{{group.id}}" bindtap="openCalendarEvent">
      <view class="grow"><view class="h2">{{group.name}}</view><view class="muted small">{{group.dateLabel}}</view></view>
      <text user-select="{{false}}" selectable="{{false}}" wx:if="{{group.openable}}" class="calendar-project-arrow">›</text>
    </view>
    <view class="calendar-project-summary"><text user-select="{{false}}" selectable="{{false}}">{{group.scheduleLabel}}</text><text user-select="{{false}}" selectable="{{false}}">{{ui.s11}} {{group.taskCount}}</text></view>
    <block wx:for="{{group.tasks}}" wx:key="id"><template is="calendar-child" data="{{task: item, ui: ui, calendarLabels: calendarLabels}}"/></block>
    <button wx:if="{{group.otherTasks.length}}" class="calendar-expand" data-id="{{group.id}}" bindtap="toggleOthers">{{group.expanded ? calendarLabels.hideOther : calendarLabels.showOther}} · {{group.otherTasks.length}} {{group.expanded ? '⌃' : '⌄'}}</button>
    <block wx:if="{{group.expanded}}"><block wx:for="{{group.otherTasks}}" wx:key="id"><template is="calendar-child" data="{{task: item, ui: ui, calendarLabels: calendarLabels}}"/></block></block>
    <view wx:if="{{!group.taskCount}}" class="calendar-no-children muted">{{calendarLabels.noChildren}}</view>
  </view>
  <view wx:if="{{!selectedGroups.length}}" class="calendar-empty card">
    <view class="muted">{{calendarLabels.emptyDay}}</view>
    <button wx:if="{{nearestDate && nearestDate !== selected}}" class="secondary" bindtap="nearest">{{calendarLabels.nearest}} · {{nearestDate}}</button>
  </view>
</view>
</block>
