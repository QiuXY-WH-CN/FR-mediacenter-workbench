<view style="{{themeStyle}}" class="page department-calendar {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}" style="--dept-color:{{departmentColor}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">{{ui.s238}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="row"><button data-delta="-1" bindtap="month">‹</button><text class="h2">{{year}} 年 {{month}} 月</text><button data-delta="1" bindtap="month">›</button></view><view class="row field"><picker range="{{deptLabels}}" value="{{deptIndex}}" bindchange="dept"><view class="picker">{{deptLabels[deptIndex]}}</view></picker><text class="link" bindtap="today">{{ui.s241}}</text></view><view class="cal"><view class="muted" wx:for="{{week}}" wx:key="*this">{{item}}</view></view><view class="cal"><view class="cell {{selected === item.id ? 'chosen' : ''}}" wx:for="{{cells}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><block wx:if="!item.empty"><view>{{item.number}}</view><view><text wx:if="item.events" class="dot"/><text wx:if="item.tasks" class="dot task-dot"/></view></block></view></view><view class="muted small">{{ui.s319}}</view><view class="actions"><text wx:for="{{legend}}" wx:key="dept" style="color:{{item.color}}" class="small">● {{item.dept}}</text></view><view class="section-title h2">{{ui.s245}}</view><scroll-view scroll-x class="time-scroll" scroll-left="{{scrollLeft}}"><view class="time-track"><view wx:for="{{days}}" wx:key="id" class="time-day {{selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose">{{item.number}} 日<text class="time-count" wx:if="item.events">{{item.events}} 场活动</text><text class="small" wx:if="item.tasks">{{item.tasks}} 项截止</text></view></view></scroll-view><view class="h2">{{selected}}</view><view class="card" wx:for="{{selectedGroups}}" wx:for-item="group" wx:key="id"><view class="h2" data-id="{{group.id}}" bindtap="openEvent">{{group.name}}</view><view class="task" wx:for="{{group.tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">↳ {{item.name}}</view><view class="muted">{{item.dueLabel}} · {{item.ownerName}} · {{item.statusLabel}}</view></view></view><view wx:if="!selectedEvents.length && !selectedTasks.length" class="empty">{{ui.s246}}</view><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
