.calendar-toolbar{display:flex;gap:16rpx;align-items:center;margin:20rpx 0 24rpx}
.calendar-department{flex:1;min-width:0}.calendar-department .picker{font-size:26rpx;padding:16rpx 18rpx;min-height:76rpx}
.calendar-today{padding:16rpx 24rpx;min-height:76rpx;color:var(--accent)}
.calendar-board{border:1rpx solid #e7e7e7;border-radius:26rpx;padding:18rpx 8rpx;background:#fff;overflow:hidden}
.calendar-month{padding:0 10rpx}.calendar-arrow{width:66rpx;min-height:64rpx;line-height:1;padding:12rpx;font-size:38rpx;border-color:transparent;background:transparent;flex-shrink:0}
.calendar-summary{display:flex;justify-content:center;gap:28rpx;margin:6rpx 0 22rpx;font-size:23rpx;color:#777}
.calendar-week{display:flex;color:#858585;font-size:24rpx;text-align:center;margin-bottom:10rpx}.calendar-week>view{width:14.285714%}
.calendar-grid{display:flex;flex-wrap:wrap;align-items:stretch}.calendar-cell{width:14.285714%;min-height:132rpx;padding:8rpx 3rpx 10rpx;border:2rpx solid transparent;border-radius:14rpx;text-align:center;position:relative;overflow:hidden}
.calendar-number{font-size:28rpx;font-weight:650;line-height:40rpx}.calendar-is-today .calendar-number{color:var(--accent);text-decoration:underline}
.calendar-selected{background:#f6f6f6;border-color:var(--accent);box-shadow:0 4rpx 12rpx #00000008}.calendar-selected .calendar-number{color:var(--accent)}
.calendar-count{display:inline-flex;align-items:center;gap:5rpx;color:var(--dept-color);font-size:23rpx;font-weight:700;min-height:30rpx;line-height:30rpx}
.calendar-count-dot{width:8rpx;height:8rpx;background:var(--dept-color);border-radius:50%}.calendar-urgent .calendar-count{color:#cb3838}.calendar-urgent .calendar-count-dot{background:#cb3838}
.calendar-event-dots{height:30rpx;display:flex;align-items:center;justify-content:center;gap:6rpx}.calendar-event-dots text{width:8rpx;height:8rpx;border-radius:50%;background:var(--accent)}
.calendar-preview{font-size:18rpx;color:#7c7c7c;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:26rpx;padding:0 1rpx}
.calendar-month-empty{text-align:center;padding:20rpx;font-size:24rpx}.calendar-agenda-heading{margin:26rpx 0 4rpx;gap:16rpx}.calendar-agenda-heading .grow{text-align:center}
.calendar-project{padding:22rpx 24rpx;margin:20rpx 0;border-top:5rpx solid var(--dept-color)}
.calendar-project-heading{gap:14rpx;padding:2rpx 0 12rpx}.calendar-project-heading .h2{font-size:31rpx;word-break:break-word}
.calendar-project-arrow,.calendar-child-arrow{font-size:36rpx;color:#949494;flex-shrink:0}
.calendar-project-summary{display:flex;justify-content:space-between;gap:14rpx;font-size:23rpx;color:#838383;padding-bottom:12rpx}
.calendar-child{display:flex;position:relative;align-items:center;gap:14rpx;margin-left:7rpx;padding:22rpx 0 22rpx 23rpx;border-left:2rpx solid #dedede;border-bottom:1rpx solid #ededed}
.calendar-child:last-child{border-bottom:0}.calendar-child-dot{position:absolute;width:12rpx;height:12rpx;border-radius:50%;left:-7rpx;top:34rpx;border:2rpx solid #fff}
.calendar-child .row{gap:12rpx}.calendar-child .h3{font-size:28rpx;line-height:1.5;word-break:break-word}.calendar-child .priority{font-size:22rpx;white-space:nowrap;padding:3rpx 8rpx;flex-shrink:0}
.calendar-task-info{display:flex;gap:12rpx;align-items:center;color:#777;font-size:24rpx;margin-top:10rpx;flex-wrap:wrap}.calendar-task-info .badge{font-size:21rpx;padding:3rpx 8rpx}
.calendar-due{display:flex;gap:10rpx;align-items:center;flex-wrap:wrap;font-size:23rpx;color:#858585;margin-top:8rpx}.calendar-due-tag{color:var(--accent);font-size:21rpx}
.calendar-no-children{font-size:25rpx;padding:18rpx 0}.calendar-expand{width:100%;padding:14rpx 12rpx;margin-top:14rpx;background:transparent;color:var(--accent);border-color:transparent;font-size:24rpx}
.calendar-empty{text-align:center;font-size:26rpx;padding:38rpx 24rpx}.calendar-empty button{margin-top:24rpx;font-size:25rpx}
.dark .calendar-board{background:#191919;border-color:#333}.dark .calendar-selected{background:#252525}.dark .calendar-preview,.dark .calendar-summary,.dark .calendar-due,.dark .calendar-task-info{color:#ababab}
.dark .calendar-child{border-color:#383838}.dark .calendar-child-dot{border-color:#191919}.compact .calendar-cell{min-height:112rpx}.compact .calendar-child{padding-top:16rpx;padding-bottom:16rpx}.calendar-cell:active{transform:scale(.96)}

.calendar-archived{border-left-color:#9b9b9b!important}.calendar-archived .calendar-child-dot{background:#9b9b9b!important}.calendar-archived .h3,.calendar-archived .calendar-due{color:#858585}.calendar-completed .calendar-count,.calendar-completed .calendar-preview{color:#888}.calendar-completed .calendar-count-dot{background:#999}.dark .calendar-archived .h3,.dark .calendar-archived .calendar-due{color:#aaa}
.calendar-mode{margin-bottom:20rpx}.calendar-timeline-scroll{width:100%;min-height:220rpx;white-space:nowrap}.calendar-timeline{position:relative;padding-bottom:12rpx;min-height:220rpx}.timeline-axis{display:flex;position:relative;z-index:4;padding-bottom:32rpx}.timeline-date{width:96rpx;min-width:96rpx;min-height:76rpx;display:flex;align-items:center;justify-content:center;font-size:calc(26rpx * var(--font-scale,1))}.timeline-today{color:#d24c40;font-weight:700}.timeline-selected{border-bottom:4rpx solid var(--accent)}.timeline-now{position:absolute;top:76rpx;bottom:4rpx;width:2rpx;background:#d24c40;z-index:3;pointer-events:none}.timeline-now:before{content:'';width:10rpx;height:10rpx;position:absolute;top:0;left:-4rpx;border-radius:50%;background:#d24c40}.timeline-now text{position:absolute;top:8rpx;left:8rpx;font-size:20rpx;background:#fff;color:#d24c40;padding:2rpx 5rpx;border-radius:4rpx}.timeline-lane{position:relative;min-height:124rpx;margin-bottom:16rpx}.timeline-schedule{position:absolute;top:0;min-height:110rpx;background:#f4f5f4;border-left:5rpx solid var(--lane-color);border-radius:18rpx;padding:18rpx 20rpx;overflow:hidden;white-space:normal}.timeline-name{font-size:calc(26rpx * var(--font-scale,1));font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.timeline-meta{font-size:calc(22rpx * var(--font-scale,1));color:#777;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.timeline-schedule.ongoing{background:#fff3e9}.timeline-schedule.ended,.timeline-schedule.timeline-inactive{background:#f0f0f0;color:#929292;border-left-color:#a0a0a0}.timeline-empty{width:650rpx;padding:44rpx 28rpx;color:#888}.calendar-inactive .h2,.calendar-inactive .h3,.calendar-inactive .calendar-count,.calendar-inactive .calendar-due{color:#929292}.dark .timeline-schedule{background:#252525}.dark .timeline-now text{background:#191919}.dark .timeline-schedule.ongoing{background:#30261e}.dark .timeline-schedule.ended,.dark .timeline-schedule.timeline-inactive{background:#202020;color:#999}.calendar-timeline,.calendar-mode{user-select:none;-webkit-user-select:none}

.calendar-inactive .calendar-child-dot{background:#999!important}.calendar-inactive .priority,.calendar-inactive .badge{background:#efefef;color:#888}.dark .calendar-inactive .priority,.dark .calendar-inactive .badge{background:#292929;color:#aaa}

.timeline-lane{min-height:176rpx}.timeline-caption{position:absolute;top:0;width:360rpx;padding:4rpx 8rpx;z-index:2;white-space:normal}.timeline-caption.ended{color:#888}.timeline-schedule{top:94rpx;min-height:58rpx;border-radius:12rpx;padding:0}.timeline-name{font-size:calc(25rpx * var(--font-scale,1))}.timeline-meta{font-size:calc(21rpx * var(--font-scale,1))}
