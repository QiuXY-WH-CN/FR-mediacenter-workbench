<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page auth-page {{fontScale > 1.12 ? 'font-large' : ''}} {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/>
  <view class="brand auth-brand">
    <image class="mark" src="/images/emblem.png" mode="aspectFit"/>
    <view class="auth-title">冯如学媒<br/>{{ui.s15}}</view>
    <view class="auth-sub">{{ui.s313}}</view>
    <view class="auth-features">{{ui.s314}}</view>
  </view>

  <view class="auth-card">
    <view class="eyebrow">FENGRU · MEDIA CENTER</view>
    <view wx:if="{{!pending}}" class="title">{{title}}</view>
    <view wx:if="{{!pending}}" class="sub">{{subtitle}}</view>

    <view wx:if="{{loading}}" class="hint">{{ui.s315}}</view>

    <block wx:elif="{{pending}}">
      <view class="pending-box">
        <view class="h2">{{disabled ? '账号已停用' : ui.s293}}</view>
        <view class="muted">{{pendingName}} · {{pendingDept}}</view>
        <view class="sub pending-note">{{disabled ? '请联系负责人确认账号权限。' : '请等待负责人审核，开通后即可进入工作台。'}}</view>
      </view>
      <view class="actions">
        <button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="check">{{ui.s316}}</button>
        <button disabled="{{busy}}" bindtap="logout">{{ui.s46}}</button>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{message}}" class="hint">{{message}}</view>
      <view wx:if="{{reviewMode && mode === 'login'}}" class="hint login-review">{{language === 'en' ? 'Accounts are temporarily sealed for review. Only the initial administrator can sign in.' : '账号审核封存中，仅初始管理员可登录。'}}</view>
      <view wx:if="{{error}}" class="error">{{error}}</view>

      <view wx:if="{{mode !== 'reset'}}" class="field">
        <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s37}}</text>
        <input value="{{username}}" data-key="username" bindinput="input" bindblur="usernameBlur" maxlength="32" placeholder="3—32 位英文、数字或 . _ -"/>
      </view>

      <block wx:if="{{mode === 'register' || mode === 'setup'}}">
        <view class="field">
          <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s35}}</text>
          <input value="{{name}}" data-key="name" bindinput="input" maxlength="30" placeholder="用于任务分配与署名"/>
        </view>
        <view class="field">
          <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s23}}</text>
          <picker range="{{deptLabels}}" value="{{deptIndex}}" bindchange="dept">
            <view class="picker">{{deptLabels[deptIndex]}}</view>
          </picker>
        </view>
      </block>

      <view wx:if="{{mode === 'register'}}" class="field">
        <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s297}}</text>
        <input value="{{invite}}" data-key="invite" bindinput="input" maxlength="128" placeholder="没有邀请码也可提交申请"/>
      </view>

      <view wx:if="{{mode === 'reset'}}" class="field">
        <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s317}}</text>
        <input value="{{resetToken}}" data-key="resetToken" bindinput="input" maxlength="128" placeholder="粘贴重置链接中的重置码"/>
      </view>

      <view class="field">
        <text user-select="{{false}}" selectable="{{false}}" class="label">{{mode === 'reset' ? ui.s41 : ui.s39}}</text>
        <input password value="{{password}}" data-key="password" bindinput="input" maxlength="72" placeholder="{{mode === 'login' ? '请输入密码' : '至少 10 个字符'}}"/>
      </view>

      <view wx:if="{{mode !== 'login'}}" class="field">
        <text user-select="{{false}}" selectable="{{false}}" class="label">{{ui.s298}}</text>
        <input password value="{{confirm}}" data-key="confirm" bindinput="input" maxlength="72" placeholder="{{ui.s298}}"/>
      </view>

      <view wx:if="{{mode === 'login' && captchaRequired && !passwordLocked}}" class="field">
        <text class="label">{{language === 'en' ? 'Verification code' : '验证码'}}</text>
        <view class="captcha-row"><input value="{{captchaAnswer}}" data-key="captchaAnswer" bindinput="input" maxlength="5" placeholder="{{language === 'en' ? '5 characters' : '5 位验证码'}}"/><image src="{{captchaImage}}" class="captcha-image" mode="aspectFit" bindtap="refreshCaptcha"/></view>
        <button class="text-btn" bindtap="refreshCaptcha">{{language === 'en' ? 'Refresh verification code' : '更换验证码'}}</button>
      </view>
      <view wx:if="{{mode === 'login' && securityHint}}" class="hint">{{securityHint}}</view>
      <view wx:if="{{mode === 'login'}}" class="login-memory">
        <checkbox-group bindchange="rememberChange"><label class="remember-label"><checkbox value="remember" checked="{{remember}}" disabled="{{busy}}" color="{{particleTheme}}"/><text>{{reviewMode ? (language === 'en' ? 'Keep me signed in' : '保持登录') : (language === 'en' ? 'Remember account & password' : '记住账号密码')}}</text></label></checkbox-group>
        <view class="remember-note">{{reviewMode ? (language === 'en' ? 'Review mode keeps your session for 30 days without remembering your account or password.' : '审核模式仅保持登录 30 天，不记住账号密码。') : (secureMemory ? (language === 'en' ? 'The platform encrypts your password. Stay signed in for 30 days on this device.' : '密码由平台加密保存，在此设备保持登录 30 天。') : (language === 'en' ? 'Remember your account and sign-in for 30 days. This device does not store passwords.' : '此设备仅记住账号并保持登录 30 天，不保存密码。'))}}</view>
        <button wx:if="{{remember && !reviewMode}}" class="text-btn remember-forget" disabled="{{busy}}" bindtap="forgetRemembered">{{language === 'en' ? 'Forget remembered account' : '清除已记住的信息'}}</button>
      </view>
      <button class="primary submit" loading="{{busy}}" disabled="{{busy || (mode === 'login' && (cooldown > 0 || passwordLocked))}}" bindtap="submit">{{cooldown > 0 && mode === 'login' ? cooldown + ' s' : submitText}}</button>

      <view class="auth-switch">
        <button wx:if="{{!reviewMode && (mode === 'login' || mode === 'register')}}" class="text-btn" data-mode="{{mode === 'login' ? 'register' : 'login'}}" bindtap="switchMode">{{mode === 'login' ? ui.s295 : ui.s296}}</button>
        <button wx:if="{{mode === 'login'}}" class="text-btn" data-mode="reset" bindtap="switchMode">{{ui.s318}}</button>
      </view>

      <view class="sub auth-note">{{mode === 'login' ? ui.s294 : ui.s299}}</view>
    </block>
  </view>

  <view class="auth-foot">
    <text user-select="{{false}}" selectable="{{false}}" class="link" bindtap="connection">{{ui.s392}}</text>
  </view>
</view>
</block>
