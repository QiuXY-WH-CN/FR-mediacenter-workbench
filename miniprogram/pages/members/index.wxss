.org105-tools{display:flex;gap:8rpx;align-items:center;flex-wrap:wrap;margin:20rpx 0}.org105-tools button{margin:0;min-width:44px;min-height:44px;padding:8px 12px;font-size:calc(12px * var(--font-scale,1));flex-shrink:0}.org105-tools text{font-size:calc(12px * var(--font-scale,1));min-width:44px;text-align:center;color:#707070}.org105-board{height:560px;max-height:68vh;min-height:380px;width:100%;position:relative;overflow:hidden;border:1px solid #e9e9e9;border-radius:20px;background:#fff;margin-bottom:26rpx}.dark .org105-board{background:#191919;border-color:#363636}.org105-scene{position:absolute;left:0;top:0;transform-origin:0 0}.org105-line{position:absolute;z-index:0;height:0;border-top:1.5px dashed;transform-origin:0 0;opacity:.38;pointer-events:none}.org105-bubble{position:absolute;box-sizing:border-box;transform:translate(-50%,-50%);border-radius:50%;border:1.5px solid var(--dept-color);background:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:calc(8px / var(--org-zoom,1));gap:calc(3px / var(--org-zoom,1));box-shadow:0 8px 24px #00000010;z-index:2;overflow:hidden;animation:none!important;transition:none!important}.dark .org105-bubble{background:#191919;color:#f2f2f2}.org105-bubble.root{border-color:var(--accent);border-width:2px;z-index:3}.org105-name{font-size:calc(12px * var(--font-scale,1) / var(--org-zoom,1));font-weight:600;line-height:1.2;max-width:100%;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;word-break:break-all}.department .org105-name{font-size:calc(13px * var(--font-scale,1) / var(--org-zoom,1))}.org105-small,.org105-description{font-size:calc(8px * var(--font-scale,1) / var(--org-zoom,1));line-height:1.2;color:#707070;max-width:100%;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}.dark .org105-small,.dark .org105-description{color:#b5b5b5}.org105-avatar{width:calc(18px * var(--font-scale,1) / var(--org-zoom,1));height:calc(18px * var(--font-scale,1) / var(--org-zoom,1));border-radius:50%;flex-shrink:0;background:#f5ede6}.org105-initial{display:flex;align-items:center;justify-content:center;font-size:calc(9px * var(--font-scale,1) / var(--org-zoom,1));color:var(--accent)}.org105-brand{font-size:calc(14px * var(--font-scale,1) / var(--org-zoom,1));font-weight:700}.mini-person-home{max-height:70vh;overflow:auto}
.presence-status{display:inline-flex;align-items:center;justify-content:center;gap:5px;color:#707070;font-size:calc(11px * var(--font-scale,1));line-height:1.3;white-space:nowrap;flex-shrink:0}.presence-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}.presence-status.is-online{color:#167d49}.dark .presence-status{color:#b5b5b5}.dark .presence-status.is-online{color:#87e5ab}.presence-status.presence-compact{font-size:calc(8px * var(--font-scale,1) / var(--org-zoom,1));gap:calc(4px / var(--org-zoom,1))}.presence-compact .presence-dot{width:calc(4px / var(--org-zoom,1));height:calc(4px / var(--org-zoom,1))}.mini-person-home>.presence-status{margin:8px 0 12px}
.org105-scene.compact .org105-bubble.person{padding:calc(6px / var(--org-zoom,1))}
