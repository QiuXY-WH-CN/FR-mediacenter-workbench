<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><view class="title">{{ui.s8}}</view><button wx:if="{{manager}}" class="primary" data-url="/pages/editor/index?mode=invite" bindtap="go">{{ui.s142}}</button><view wx:if="{{syncError}}" class="error">{{syncError}}</view><view class="h2">{{ui.s9}}</view><view class="actions"><button bindtap="department">{{ui.s123}}</button></view><view class="bubble-board"><view wx:for="{{network}}" wx:key="dept" class="bubble-line" style="left:50%;top:50%;width:{{item.lineLength}}%;transform:rotate({{item.lineAngle}}deg)"/><view class="bubble-center">冯如学媒</view><view class="mini-cluster" wx:for="{{network}}" wx:for-item="group" wx:key="dept" style="left:{{group.x}}%;top:{{group.y}}%;--dept-color:{{group.color}}"><view class="mini-dept-bubble" data-dept="{{group.dept}}" data-index="{{group.index}}" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragEnd" bindtap="toggleDepartment">{{group.dept}}<view class="muted small">{{group.people.length}} 位伙伴 · 点击展开</view></view><view wx:if="{{group.expanded}}" class="mini-orbit"><view wx:for="{{group.people}}" wx:for-item="person" wx:key="id" class="mini-member" data-id="{{person.id}}" bindtap="person"><image wx:if="{{person.avatar}}" src="{{person.avatar}}"/><view>{{person.name}}</view><view class="small">{{person.roleLabel}}</view></view></view></view></view><view wx:if="{{selectedPerson}}" class="context-dismiss" bindtap="closePerson"/><view wx:if="{{selectedPerson}}" class="card mini-person-home"><image wx:if="{{selectedPerson.avatar}}" class="profile-avatar" src="{{selectedPerson.avatar}}"/><view class="h2">{{selectedPerson.name}}</view><view>@{{selectedPerson.username}}</view><view class="muted">{{selectedPerson.dept}} · {{selectedPerson.roleLabel}}</view><button class="space" bindtap="closePerson">{{ui.s51}}</button></view><view wx:if="{{admin}}" class="card"><view class="h2">{{ui.s259}}</view><view wx:for="{{reviews}}" wx:key="user" class="split"><image wx:if="{{item.pending_avatar}}" class="member-avatar" src="{{item.pending_avatar}}"/><view>{{item.name}} → {{item.pending_name}}</view><view class="muted">{{item.dept}}</view><view class="actions"><button data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="reject" bindtap="review">{{ui.s224}}</button><button class="primary" data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="approve" bindtap="review">{{ui.s225}}</button></view></view><view wx:if="{{!reviews.length}}" class="muted">{{ui.s261}}</view></view><view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="dept" style="border-top:6rpx solid {{group.color}}"><view class="h2">{{group.dept}} · {{group.people.length}} 人</view><view wx:for="{{group.people}}" wx:for-item="person" wx:key="id" class="split"><view class="row"><image wx:if="{{person.avatar}}" class="member-avatar" src="{{person.avatar}}"/><view class="h3 grow">{{person.name}}</view><text user-select="{{false}}" selectable="{{false}}" class="tag">{{person.statusLabel}}</text></view><view class="muted">{{person.roleLabel}} · @{{person.username}}</view><button wx:if="{{person.canEdit}}" class="safe-button" data-url="/pages/editor/index?mode=member&amp;id={{person.id}}" bindtap="go">{{ui.s222}}</button></view></view></view>
</block>
