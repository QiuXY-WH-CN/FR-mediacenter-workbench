<view class="page"><view class="title">成员与权限</view><button wx:if="{{manager}}" class="primary" data-url="/pages/editor/index?mode=invite" bindtap="go">＋ 邀请成员</button><view wx:if="{{syncError}}" class="error">{{syncError}}</view><view class="card"><view class="h2">学媒协作网络</view><view class="muted small">点击部门筛选，点击伙伴查看资料。连线表示部门归属。</view><view class="org-root" bindtap="department">冯如学媒 · 显示全部</view><view class="org-branch" wx:for="{{allGroups}}" wx:for-item="group" wx:key="dept" style="--dept-color:{{group.color}}"><view class="org-dept" data-dept="{{group.dept}}" bindtap="department">{{group.dept}}</view><view class="org-people"><view class="org-person" wx:for="{{group.people}}" wx:for-item="person" wx:key="id" data-id="{{person.id}}" bindtap="person"><image wx:if="{{person.avatar}}" class="member-avatar" src="{{person.avatar}}"/><text>{{person.name}}</text></view></view></view></view><view wx:if="{{admin}}" class="card"><view class="h2">姓名与头像审核</view><view wx:for="{{reviews}}" wx:key="user" class="split"><image wx:if="{{item.pending_avatar}}" class="member-avatar" src="{{item.pending_avatar}}"/><view>{{item.name}} → {{item.pending_name}}</view><view class="muted">{{item.dept}}</view><view class="actions"><button data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="reject" bindtap="review">退回</button><button class="primary" data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="approve" bindtap="review">批准</button></view></view><view wx:if="{{!reviews.length}}" class="muted">暂无待审核申请</view></view><view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="dept" style="border-top:6rpx solid {{group.color}}"><view class="h2">{{group.dept}} · {{group.people.length}} 人</view><view wx:for="{{group.people}}" wx:for-item="person" wx:key="id" class="split"><view class="row"><image wx:if="{{person.avatar}}" class="member-avatar" src="{{person.avatar}}"/><view class="h3 grow">{{person.name}}</view><text class="tag">{{person.statusLabel}}</text></view><view class="muted">{{person.roleLabel}} · @{{person.username}}</view><button wx:if="{{person.canEdit}}" class="safe-button" data-url="/pages/editor/index?mode=member&amp;id={{person.id}}" bindtap="go">审批 / 管理</button></view></view></view>