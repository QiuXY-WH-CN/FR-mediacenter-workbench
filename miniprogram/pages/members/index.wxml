<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="members" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/><view class="title">{{ui.s8}}</view><button wx:if="{{manager}}" class="primary" data-url="/pages/editor/index?mode=invite" bindtap="go">{{ui.s142}}</button><view wx:if="{{syncError}}" class="error">{{syncError}}</view><view class="h2">{{ui.s9}}</view><view class="org105-tools"><button bindtap="department">{{ui.s123}}</button><button bindtap="collapse">{{orgText.collapse}}</button><button bindtap="zoomOut" aria-label="{{orgText.out}}">−</button><text user-select="{{false}}" selectable="{{false}}">{{zoomLabel}}</text><button bindtap="zoomIn" aria-label="{{orgText.in}}">＋</button><button bindtap="center">{{orgText.center}}</button></view>
<view class="org105-board" catchtouchstart="orgStart" catchtouchmove="orgMove" catchtouchend="orgEnd" catchtouchcancel="orgEnd"><view class="org105-scene {{orgCompact ? 'compact' : ''}}" style="width:{{worldWidth}}px;height:{{worldHeight}}px;transform:translate({{cameraX}}px,{{cameraY}}px) scale({{zoom}});--org-zoom:{{zoom}};">
<view class="org105-line" wx:for="{{orgLinks}}" wx:key="id" style="left:{{item.x1}}px;top:{{item.y1}}px;width:{{item.length}}px;transform:rotate({{item.angle}}deg);border-color:{{item.color}};"/>
<view class="org105-bubble {{item.kind}}" wx:for="{{orgNodes}}" wx:key="id" style="{{item.position}}width:{{item.diameter}}px;height:{{item.diameter}}px;--dept-color:{{item.color}};" data-node="{{item.kind === 'root' ? '' : item.id}}" catchtouchstart="orgStart" catchtouchmove="orgMove" catchtouchend="orgEnd" catchtouchcancel="orgEnd">
<block wx:if="{{item.kind === 'person'}}"><block wx:if="{{!orgCompact}}"><image wx:if="{{item.avatar}}" class="org105-avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="org105-avatar org105-initial">{{item.initial}}</view></block><view class="org105-name">{{item.name}}</view><view wx:if="{{!orgCompact}}" class="org105-small">{{item.roleLabel}}</view><view class="presence-status presence-compact {{item.online ? 'is-online' : 'is-offline'}}"><view class="presence-dot"/><text user-select="{{false}}" selectable="{{false}}">{{item.onlineLabel}}</text></view></block>
<block wx:elif="{{item.kind === 'department'}}"><view class="org105-name">{{item.name}}</view><view class="org105-description">{{item.description}}</view><view class="org105-small">{{item.peopleCount}} {{orgText.people}} · {{item.expanded ? orgText.collapse : orgText.expand}}</view></block>
<block wx:else><view class="org105-brand">冯如学媒</view><view class="org105-small">MEDIA CENTER</view></block>
</view></view></view><view wx:if="{{selectedPerson}}" class="context-dismiss" bindtap="closePerson"/><view wx:if="{{selectedPerson}}" class="card mini-person-home"><image wx:if="{{selectedPerson.avatar}}" class="profile-avatar" src="{{selectedPerson.avatar}}"/><view class="h2">{{selectedPerson.name}}</view><view>@{{selectedPerson.username}}</view><view class="presence-status {{selectedPerson.online ? 'is-online' : 'is-offline'}}"><view class="presence-dot"/><text user-select="{{false}}" selectable="{{false}}">{{selectedPerson.onlineLabel}}</text></view><view class="muted">{{selectedPerson.dept}} · {{selectedPerson.roleLabel}}</view><button class="space" bindtap="closePerson">{{ui.s51}}</button></view><view wx:if="{{admin}}" class="card"><view class="h2">{{ui.s259}}</view><view wx:for="{{reviews}}" wx:key="user" class="split"><image wx:if="{{item.pending_avatar}}" class="member-avatar" src="{{item.pending_avatar}}"/><view>{{item.name}} → {{item.pending_name}}</view><view class="muted">{{item.dept}}</view><view class="actions"><button data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="reject" bindtap="review">{{ui.s224}}</button><button class="primary" data-id="{{item.user}}" data-revision="{{item.revision}}" data-action="approve" bindtap="review">{{ui.s225}}</button></view></view><view wx:if="{{!reviews.length}}" class="muted">{{ui.s261}}</view></view><view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="dept" style="border-top:6rpx solid {{group.color}}"><view class="h2">{{group.dept}} · {{group.people.length}} 人</view><view wx:for="{{group.people}}" wx:for-item="person" wx:key="id" class="split"><view class="row"><image wx:if="{{person.avatar}}" class="member-avatar" src="{{person.avatar}}"/><view class="h3 grow">{{person.name}}</view><view class="presence-status {{person.online ? 'is-online' : 'is-offline'}}"><view class="presence-dot"/><text user-select="{{false}}" selectable="{{false}}">{{person.onlineLabel}}</text></view><text user-select="{{false}}" selectable="{{false}}" class="tag">{{person.statusLabel}}</text></view><view class="muted">{{person.roleLabel}} · @{{person.username}}</view><button wx:if="{{person.canEdit}}" class="safe-button" data-url="/pages/editor/index?mode=member&amp;id={{person.id}}" bindtap="go">{{ui.s222}}</button></view></view></view>
</block>
