<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd">
  <particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="events" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/>
  <view class="title">{{ui.s2}}</view><button wx:if="{{manager}}" class="primary" data-url="/pages/editor/index?mode=event-new" bindtap="go">{{ui.s141}}</button>
  <view class="tabs"><view wx:for="{{tabs}}" wx:key="id" class="tab {{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view>
  <view class="archive-filters card"><input value="{{query}}" bindinput="search" placeholder="{{language === 'en' ? 'Search schedules, tasks or members' : '搜索日程、任务或成员'}}" confirm-type="search"/><view class="two archive-filter-row"><picker range="{{years}}" value="{{yearIndex}}" data-key="yearIndex" bindchange="selector"><view class="picker">{{years[yearIndex]}} ▾</view></picker><picker range="{{departmentOptions}}" value="{{departmentIndex}}" data-key="departmentIndex" bindchange="selector"><view class="picker">{{departmentOptions[departmentIndex]}} ▾</view></picker><picker wx:if="{{archive}}" range="{{completionOptions}}" value="{{completionIndex}}" data-key="completionIndex" bindchange="selector"><view class="picker">{{completionOptions[completionIndex]}} ▾</view></picker><picker range="{{seriesOptions}}" value="{{seriesIndex}}" data-key="seriesIndex" bindchange="selector"><view class="picker">{{seriesOptions[seriesIndex]}} ▾</view></picker></view><view class="row"><text class="muted small">{{groups.length}} {{language === 'en' ? 'schedules' : '个日程'}} · {{visibleTaskCount}} {{language === 'en' ? 'tasks' : '项任务'}}</text><view class="link small" bindtap="resetFilters">{{language === 'en' ? 'Reset filters' : '重置筛选'}}</view></view></view>
  <view wx:if="{{syncError}}" class="error">{{syncError}}</view>
  <view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">{{ui.s394}} {{urgent.length}}</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view>
  <view class="card {{archive ? 'archive-group' : ''}} {{group.scheduleEnabled === false ? 'schedule-muted' : ''}}" wx:for="{{groups}}" wx:for-item="group" wx:key="id">
    <view class="row"><view class="grow" data-id="{{group.id}}" bindtap="openEvent"><text user-select="{{false}}" selectable="{{false}}" class="tag">{{group.seriesName || group.type || ui.s235}}</text><view class="h2">{{group.name}}</view><view class="muted">{{group.dateLabel}}</view><view class="muted small">{{group.academicYear}} {{language === 'en' ? 'academic year' : '学年'}} · {{group.doneCount}} / {{group.allTaskCount}} {{language === 'en' ? 'archived' : '已归档'}}</view><text wx:if="{{!archive && group.scheduleEnabled === false}}" class="badge">{{group.scheduleLabel}}</text></view><button class="expand-tasks" data-id="{{group.id}}" bindtap="toggle">{{group.open ? '▾' : '▸'}} {{group.tasks.length}} {{childLabel}}</button></view>
    <block wx:if="{{group.open}}"><view class="task {{archive ? 'archived-task' : ''}} {{item.scheduleEnabled === false ? 'schedule-muted' : ''}}" wx:for="{{group.tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="h3 grow">{{item.name}}</view><text user-select="{{false}}" selectable="{{false}}" class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted small">{{item.departmentLabel}}</view><view class="muted">{{item.ownerName}} → {{item.receiverName}}</view><view wx:if="{{archive && item.submission}}" class="archive-excerpt">{{item.submission}}</view><view class="row"><text user-select="{{false}}" selectable="{{false}}" class="muted">{{item.dueLabel}}</text><text user-select="{{false}}" selectable="{{false}}" class="reward">+{{item.rewardLabel}}</text></view></view></block>
  </view>
  <view wx:if="{{!groups.length}}" class="empty">{{archive ? archiveEmpty : ui.s346}}</view>
</view>
</block>
