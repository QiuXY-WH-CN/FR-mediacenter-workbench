<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">所有任务</view><button wx:if="{{ manager }}" class="primary" data-url="/pages/editor/index?mode=event-new" bindtap="go">＋ 新建活动</button><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">急急急 · {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text class="priority {{item.priority}}">{{item.priorityLabel}}优先级</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="card" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><text class="tag">{{item.type || '自由活动'}}</text><view class="h2">{{item.name}}</view><view class="muted">{{item.dateLabel}}</view><view class="muted">{{item.location || '地点待定'}} · {{item.taskCount}} 项任务</view><view wx:if="item.cloudUrl" class="reward">已设置活动素材库</view></view><view wx:if="!events.length" class="empty">还没有活动，可先创建一个空白日程。</view></view>
