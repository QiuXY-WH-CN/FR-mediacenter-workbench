<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><view class="title">{{ui.s2}}</view><button wx:if="{{ manager }}" class="primary" data-url="/pages/editor/index?mode=event-new" bindtap="go">{{ui.s141}}</button><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">{{ui.s394}} {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="card" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><text user-select="{{false}}" selectable="{{false}}" class="tag">{{item.type || ui.s235}}</text><view class="h2">{{item.name}}</view><view class="muted">{{item.dateLabel}}</view><view class="muted">{{item.location || '地点待定'}} · {{item.taskCount}} 项任务</view><view wx:if="item.cloudUrl" class="reward">{{ui.s345}}</view></view><view wx:if="!events.length" class="empty">{{ui.s346}}</view></view>
</block>
