<view class="page"><view class="title">活动协作</view><button wx:if="{{ manager }}" class="primary" data-url="/pages/editor/index?mode=event-new" bindtap="go">＋ 新建活动</button><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card" wx:for="{{events}}" wx:key="id" data-id="{{item.id}}" bindtap="openEvent"><text class="tag">{{item.type || '自由活动'}}</text><view class="h2">{{item.name}}</view><view class="muted">{{item.dateLabel}}</view><view class="muted">{{item.location || '地点待定'}} · {{item.taskCount}} 项任务</view><view wx:if="item.cloudUrl" class="reward">已设置活动素材库</view></view><view wx:if="!events.length" class="empty">还没有活动，可先创建一个空白日程。</view></view>
