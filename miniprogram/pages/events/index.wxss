.expand-tasks{flex:none;max-width:45%;height:auto;min-height:88rpx;font-size:.88em;white-space:normal;margin-left:12rpx}.archived-task{border-left:4rpx solid #9b9b9b;padding-left:18rpx}.archived-task .h3,.archived-task .reward{color:#858585}.dark .archived-task .h3,.dark .archived-task .reward{color:#aaa}.archive-group .tag{background:#eee;color:#777}.dark .archive-group .tag{background:#292929;color:#aaa}
.archive-filter-row{margin:18rpx 0}.archive-filters .picker{font-size:calc(25rpx * var(--font-scale,1))}.archive-excerpt{margin:14rpx 0;color:#666;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:calc(25rpx * var(--font-scale,1));white-space:pre-wrap}.dark .archive-excerpt{color:#bbb}.schedule-muted .h2,.schedule-muted .h3,.schedule-muted .reward{color:#8b8b8b}.dark .schedule-muted .h2,.dark .schedule-muted .h3{color:#aaa}

.schedule-muted .priority,.schedule-muted .badge{background:#efefef;color:#888}.dark .schedule-muted .priority,.dark .schedule-muted .badge{background:#292929;color:#aaa}
