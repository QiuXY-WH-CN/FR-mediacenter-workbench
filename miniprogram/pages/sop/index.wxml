<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off' && !navigationOpen}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><workspace-nav bindopenchange="navigationChange" id="workspace-nav" current="sop" language="{{language}}" dark="{{dark}}" theme="{{particleTheme}}" user="{{currentUser}}"/><view class="title">{{ui.s5}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view>
<block wx:if="{{ selected }}">
  <button bindtap="back">{{language === 'en' ? 'Back to directory' : '返回目录'}}</button>
  <view class="h2 section-title">{{selected.title}}</view>
  <view wx:if="{{ progress.total }}" class="sop-progress"><view class="row split"><view class="muted small">{{language === 'en' ? 'Progress' : '学习进度'}} · {{progress.done}} / {{progress.total}}</view><view class="link small" bindtap="resetProgress">{{language === 'en' ? 'Reset' : '重置'}}</view></view><view class="sop-progress-track"><view class="sop-progress-fill" style="width: {{progress.total ? (progress.done * 100 / progress.total) : 0}}%"></view></view></view>
  <view wx:if="{{ selected.checks.length }}" class="sop-checks"><view class="sop-check {{item.checked ? 'on' : ''}}" wx:for="{{selected.checks}}" wx:key="index" data-index="{{index}}" bindtap="toggleCheck"><view class="sop-check-box">{{item.checked ? '✓' : ''}}</view><view class="sop-check-text">{{item.text}}</view></view></view>
  <rich-text class="sop-md" nodes="{{selected.rendered.html}}"></rich-text>
</block>
<block wx:else>
  <view class="hint">{{ui.s358}}</view>
  <view class="card" wx:for="{{documents}}" wx:key="path" data-index="{{index}}" bindtap="read"><view class="h3">{{item.title}}</view><view class="muted small">{{item.path}}</view></view>
</block>
</view>
</block>
