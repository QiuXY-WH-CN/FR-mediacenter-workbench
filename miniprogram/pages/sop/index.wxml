<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot {{item.edge ? 'edge-dot edge-' + item.side : 'center-dot'}}" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;opacity:{{item.opacity || 1}};"/></view><view class="title">{{ui.s5}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ selected }}"><button bindtap="back">{{ui.s357}}</button><view class="h2 section-title">{{selected.title}}</view><view class="pre">{{selected.content}}</view><view wx:for="{{selected.images}}" wx:key="url" class="card"><view class="h3">{{item.caption}}</view><image src="{{item.url}}" mode="widthFix" style="width:100%" data-url="{{item.url}}" bindtap="preview"/></view></block><block wx:else><view class="hint">{{ui.s358}}</view><view class="card" wx:for="{{documents}}" wx:key="path" data-index="{{index}}" bindtap="read"><view class="h3">{{item.title}}</view><view class="muted small">{{item.path}}</view></view></block></view>
</block>
