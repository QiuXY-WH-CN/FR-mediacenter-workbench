<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" style="{{themeStyle}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><view class="title">{{ui.s5}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ selected }}"><button bindtap="back">{{ui.s357}}</button><view class="h2 section-title">{{selected.title}}</view><text class="pre selectable-copy" selectable="{{true}}" user-select="{{true}}">{{selected.content}}</text><view wx:for="{{selected.images}}" wx:key="url" class="card"><view class="h3">{{item.caption}}</view><image src="{{item.url}}" mode="widthFix" style="width:100%" data-url="{{item.url}}" bindtap="preview"/></view></block><block wx:else><view class="hint">{{ui.s358}}</view><view class="card" wx:for="{{documents}}" wx:key="path" data-index="{{index}}" bindtap="read"><view class="h3">{{item.title}}</view><view class="muted small">{{item.path}}</view></view></block></view>
</block>
