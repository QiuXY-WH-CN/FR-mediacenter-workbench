<view class="page"><view class="title">知识库</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ selected }}"><button bindtap="back">返回目录</button><view class="h2 section-title">{{selected.title}}</view><view class="pre">{{selected.content}}</view></block><block wx:else><view class="hint">办公室统一登记 → 分工与执行 → 交付 → 验收 → 归档。标准流程保底，创作空间放开。</view><view class="card" wx:for="{{documents}}" wx:key="path" data-index="{{index}}" bindtap="read"><view class="h3">{{item.title}}</view><view class="muted small">{{item.path}}</view></view></block></view>

