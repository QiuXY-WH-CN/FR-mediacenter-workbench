<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">{{ui.s5}}</view><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><block wx:if="{{ selected }}"><button bindtap="back">{{ui.s357}}</button><view class="h2 section-title">{{selected.title}}</view><view class="pre">{{selected.content}}</view><view wx:for="{{selected.images}}" wx:key="url" class="card"><view class="h3">{{item.caption}}</view><image src="{{item.url}}" mode="widthFix" style="width:100%" data-url="{{item.url}}" bindtap="preview"/></view></block><block wx:else><view class="hint">{{ui.s358}}</view><view class="card" wx:for="{{documents}}" wx:key="path" data-index="{{index}}" bindtap="read"><view class="h3">{{item.title}}</view><view class="muted small">{{item.path}}</view></view></block><view wx:if="{{accountOpen || selectedPerson}}" class="context-dismiss" bindtap="closeContext"/><view class="native-account"><view class="native-account-trigger" bindtap="accountToggle" bindlongpress="accountPin"><image wx:if="{{currentUser.avatar}}" class="member-avatar" src="{{currentUser.avatar}}"/><text wx:else class="account-initial">{{currentUser.name}}</text><text>{{ui.s29}}</text></view><view wx:if="{{accountOpen}}" class="native-account-menu"><view class="h3">{{currentUser.name}}</view><view class="muted small">@{{currentUser.username}}</view><view class="menu" data-url="/pages/profile/index" bindtap="go">{{ui.s30}}</view><view class="menu" data-url="/pages/profile/preferences" bindtap="go">{{ui.s28}}</view><view class="menu" bindtap="accountLogout">{{ui.s45}}</view></view></view></view>
