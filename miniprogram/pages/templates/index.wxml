<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view class="page {{motion ? '' : 'motion-off'}} {{compact ? 'compact' : ''}} {{respectReduced ? 'respect-reduced' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot {{item.edge ? 'edge-dot edge-' + item.side : 'center-dot'}}" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;opacity:{{item.opacity || 1}};"/></view><view class="title">{{ui.s4}}</view><button wx:if="{{ manager }}" class="primary" data-url="/pages/editor/index?mode=template-new" bindtap="go">{{ui.s145}}</button><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card"><view class="h2">{{ui.s376}}</view><view class="muted">{{ui.s377}}</view><button wx:if="{{ manager }}" class="safe-button" data-url="/pages/editor/index?mode=event-new" bindtap="go">{{ui.s378}}</button></view><view class="card" wx:for="{{templates}}" wx:key="id"><view class="tag">{{item.createdBy ? '团队模板' : ui.s420}}</view><view class="h2">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="split" wx:for="{{item.steps}}" wx:for-item="step" wx:key="index"><view>{{index + 1}}. {{step.name}}</view><view class="muted">{{step.dept}} · 相对活动 {{step.offset}} 天 {{step.time}}</view></view><view wx:if="{{ manager }}" class="actions"><button class="primary" data-url="/pages/editor/index?mode=event-new&template={{item.id}}" bindtap="go">{{ui.s379}}</button><button data-url="/pages/editor/index?mode=template-edit&id={{item.id}}" bindtap="go">{{item.canEdit ? '编辑' : ui.s422}}</button></view></view></view>
</block>
