<view class="page"><view class="title">流程模板</view><button wx:if="{{ manager }}" class="primary" data-url="/pages/editor/index?mode=template-new" bindtap="go">＋ 创建模板</button><view wx:if="{{ syncError }}" class="error">{{syncError}}</view><view class="card"><view class="h2">空白日程</view><view class="muted">先记录活动时间，之后再按需派单。</view><button wx:if="{{ manager }}" class="safe-button" data-url="/pages/editor/index?mode=event-new" bindtap="go">从空白开始</button></view><view class="card" wx:for="{{templates}}" wx:key="id"><view class="tag">{{item.createdBy ? '团队模板' : 'SOP 标准流程'}}</view><view class="h2">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="split" wx:for="{{item.steps}}" wx:for-item="step" wx:key="index"><view>{{index + 1}}. {{step.name}}</view><view class="muted">{{step.dept}} · 相对活动 {{step.offset}} 天 {{step.time}}</view></view><view wx:if="{{ manager }}" class="actions"><button class="primary" data-url="/pages/editor/index?mode=event-new&template={{item.id}}" bindtap="go">使用</button><button data-url="/pages/editor/index?mode=template-edit&id={{item.id}}" bindtap="go">{{item.canEdit ? '编辑' : '复制编辑'}}</button></view></view></view>
