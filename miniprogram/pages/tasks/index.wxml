<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}}"><view wx:if="{{ambientDots.length}}" class="ambient-particles {{particleStyle}}"><view wx:for="{{ambientDots}}" wx:key="id" class="ambient-dot" style="left:{{item.x}}%;top:{{item.y}}%;animation-delay:{{item.delay}}s;"/></view><view class="title">我的任务</view><view class="tabs"><view class="tab {{filter === item.id ? 'selected' : ''}}" wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view><view wx:if="{{syncError}}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">急急急 · {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text class="priority {{item.priority}}">{{item.priorityLabel}}优先级</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="id"><view class="row h2" data-id="{{group.id}}" bindtap="toggle"><text class="grow">{{group.open ? '▾' : '▸'}} {{group.name}}</text><text class="muted small">{{group.tasks.length}} 子任务</text></view><block wx:if="{{group.open}}"><view class="task" wx:for="{{group.tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="grow h3">{{item.name}}</view><text class="priority {{item.priority}}">{{item.priorityLabel}}优先级</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.ownerName}} → {{item.receiverName}}</view><view class="row"><view class="muted">{{item.dueLabel}}</view><text class="reward">+{{item.rewardPoints || 0}} 分</text></view></view></block></view><view wx:if="{{!tasks.length}}" class="empty">当前没有任务</view></view>