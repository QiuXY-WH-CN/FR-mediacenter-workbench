<include src="../../templates/share-preview.wxml"/>
<block wx:if="{{!sharePreview}}">
<view style="{{themeStyle}}" class="page {{dark ? 'dark' : ''}} {{motion ? '' : 'motion-off'}} {{fontScale > 1.12 ? 'font-large' : ''}}" bindtouchstart="particleTouchStart" bindtouchmove="particleTouchMove" bindtouchend="particleTouchEnd" bindtouchcancel="particleTouchEnd"><particle-field id="particle-field" enabled="{{motion && particles !== 'off'}}" effect="{{particleStyle}}" density="{{particleDensity}}" settings="{{particleSystem}}" theme="{{particleTheme}}" rotation="{{rotationMinutes}}"/><view class="title">{{ui.s1}}</view><view class="tabs"><view class="tab {{filter === item.id ? 'selected' : ''}}" wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bindtap="filter">{{item.label}}</view></view><view wx:if="{{syncError}}" class="error">{{syncError}}</view><view class="card urgent-panel" wx:if="{{urgent.length}}"><view class="h2">{{ui.s394}} {{urgent.length}} 项</view><view class="task" wx:for="{{urgent}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><view class="h3">{{item.name}}</view><view class="muted">{{item.eventName}} · {{item.dueLabel}}</view></view></view><view class="card" wx:for="{{groups}}" wx:for-item="group" wx:key="id"><view class="row h2" data-id="{{group.id}}" bindtap="toggle"><text user-select="{{false}}" selectable="{{false}}" class="grow">{{group.open ? '▾' : '▸'}} {{group.name}}</text><text user-select="{{false}}" selectable="{{false}}" class="muted small">{{group.tasks.length}} 子任务</text></view><block wx:if="{{group.open}}"><view class="task" wx:for="{{group.tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask"><view class="row"><view class="grow h3">{{item.name}}</view><text user-select="{{false}}" selectable="{{false}}" class="priority {{item.priority}}">{{item.priorityLabel}}{{ui.s98}}</text><text user-select="{{false}}" selectable="{{false}}" class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted">{{item.ownerName}} → {{item.receiverName}}</view><view class="row"><view class="muted">{{item.dueLabel}}</view><text user-select="{{false}}" selectable="{{false}}" class="reward">+{{item.rewardLabel}} 分</text></view></view></block></view><view wx:if="{{!tasks.length}}" class="empty">{{ui.s128}}</view></view>
</block>
