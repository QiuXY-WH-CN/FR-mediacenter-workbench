page{background:#fff;color:#292623;font:30rpx/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;box-sizing:border-box;max-width:960px;margin:0 auto}view,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:16rpx;margin:0;line-height:1.5;padding:20rpx 26rpx;background:#fff;color:#292623;border:1rpx solid #e8e1d8}button::after{border:0}.page{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));max-width:960px;margin:0 auto;width:100%}.title{font-size:44rpx;font-weight:700;line-height:1.35;margin:8rpx 0 18rpx}.h2{font-size:34rpx;font-weight:650}.h3{font-size:30rpx;font-weight:600}.eyebrow{font-size:22rpx;color:#ad4f0b;letter-spacing:3rpx}.muted{font-size:26rpx;color:#777067}.small{font-size:24rpx}.primary{background:#ff881f;border-color:#ff881f;color:#3f250d;font-weight:600}.secondary{border-color:#efc38e;color:#a74700}.danger{color:#c33232;border-color:#f0c0bb}.link{color:#b04b05}.card{border:1rpx solid #ebe6df;border-radius:22rpx;padding:28rpx;margin:24rpx 0;background:white}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.row.start{align-items:flex-start}.grow{flex:1;min-width:0}.wrap{flex-wrap:wrap}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:22rpx}.actions button{flex:1;min-width:180rpx}.stats{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:28rpx 0}.stat{border:1rpx solid #ebe6df;border-top:5rpx solid #ff901e;border-radius:20rpx;padding:24rpx}.stat:nth-child(2){border-top-color:#eeaf1c}.stat:nth-child(3){border-top-color:#e94935}.stat .number{font-size:52rpx;font-weight:700}.task{padding:24rpx 0;border-bottom:1rpx solid #eee8e0}.task:last-child{border:0}.badge{display:inline-block;border-radius:8rpx;padding:4rpx 12rpx;font-size:24rpx;white-space:nowrap;background:#f3f0eb;color:#6e6255}.badge.active,.badge.pending{background:#fff0dc;color:#a44600}.badge.review{background:#fff4c4;color:#916400}.badge.revise,.badge.conflict{background:#fff0ed;color:#b8342a}.reward{color:#956000;font-size:26rpx}.hint{background:#fff8e9;color:#885018;padding:22rpx;border:1rpx solid #ffe1b6;border-radius:16rpx;font-size:26rpx;margin:20rpx 0}.error{background:#fff0ed;color:#b7342b;padding:22rpx;border-radius:16rpx;margin:18rpx 0;font-size:26rpx}.field{display:block;margin:24rpx 0}.label{display:block;font-size:28rpx;margin-bottom:12rpx;font-weight:500}input,.picker,textarea{width:100%;border:1rpx solid #ddd6ce;border-radius:14rpx;padding:20rpx 22rpx;font-size:30rpx;background:white;min-height:84rpx}textarea{height:190rpx;line-height:1.6}.two{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.check{display:flex;gap:12rpx;align-items:flex-start;padding:16rpx 0;font-size:28rpx}.divider{height:1rpx;background:#eee5dc;margin:24rpx 0}.pre{white-space:pre-wrap;word-break:break-word;font-size:28rpx}.empty{padding:48rpx 20rpx;text-align:center;color:#81766b;font-size:28rpx}.menu{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #eee5dc}.logo{width:58rpx;height:64rpx;margin-right:18rpx}.brand{display:flex;align-items:center;margin-bottom:30rpx;font-weight:600}.safe-button{margin-top:30rpx}.tabs{display:flex;white-space:nowrap;gap:14rpx}.tab{display:inline-block;margin-right:14rpx;padding:12rpx 24rpx;background:#f6f4f1;border-radius:12rpx;font-size:26rpx}.tab.selected{background:#fff0dc;color:#a84d00}.points{font-size:68rpx;color:#ae5900;font-weight:700}.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center}.cal .cell{height:100rpx;border-bottom:1rpx solid #f0e9e1;padding-top:12rpx;font-size:28rpx}.cal .chosen{background:#fff0da;border-radius:12rpx;color:#a64700}.dot{width:9rpx;height:9rpx;border-radius:50%;background:#f98a20;display:inline-block;margin:0 3rpx}.dot.task-dot{background:#d54337}.time-scroll{width:100%;white-space:nowrap;margin:20rpx 0;border:1rpx solid #eee2d1;border-radius:14rpx}.time-track{display:flex}.time-day{width:140rpx;min-height:180rpx;flex-shrink:0;border-right:1rpx solid #eee2d1;padding:14rpx;text-align:center;font-size:26rpx}.time-day.selected{background:#fff6e4}.time-count{display:block;background:#ffebcb;color:#985213;border-radius:10rpx;padding:8rpx;font-size:22rpx;margin-top:14rpx;white-space:normal}.section-title{margin:26rpx 0 12rpx}.split{padding:20rpx 0;border-bottom:1rpx solid #eee}.tag{font-size:24rpx;background:#fff3dd;color:#9f5800;border-radius:8rpx;padding:3rpx 10rpx}.space{height:20rpx}.fixed-actions{position:sticky;bottom:0;background:#fff;padding:18rpx 0 calc(10rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eee5dc;margin-top:22rpx;z-index:10}


.member-avatar{width:64rpx;height:64rpx;border-radius:50%;flex-shrink:0}.profile-avatar{width:150rpx;height:150rpx;border-radius:50%}.org-root{text-align:center;padding:24rpx;background:#fff0de;border-radius:30rpx;margin:24rpx 0}.org-branch{border-left:2rpx dashed var(--dept-color);padding:16rpx 20rpx;margin-left:30rpx}.org-dept{color:var(--dept-color);font-weight:bold}.org-people{display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0}.org-person{display:flex;flex-direction:column;align-items:center;border:2rpx solid var(--dept-color);border-radius:24rpx;padding:12rpx;color:var(--dept-color);animation:orgfloat 5s ease-in-out infinite}.org-person:nth-child(even){animation-delay:-2.5s}.department-calendar .chosen,.department-calendar .time-day.selected{background:var(--dept-color);color:white}.department-calendar .dot{background:var(--dept-color)}.department-calendar .card{border-left:6rpx solid var(--dept-color)}@keyframes orgfloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6rpx)}}

.person-menu{border:2rpx solid #e4d6c7;border-radius:18rpx;max-height:520rpx;overflow:auto;background:white}.person-dept{padding:24rpx;font-weight:bold}.person-choice{padding:20rpx 38rpx;border-top:1rpx solid #f0e8df}.person-choice:active{background:#fff0de}

.page{--accent:#e77b24;position:relative}.page .primary{background:var(--accent);border-color:var(--accent);color:white}.page .link,.page .eyebrow{color:var(--accent)}.page .stat{border-top-color:var(--accent)}.priority{font-size:20rpx;padding:4rpx 12rpx;border-radius:20rpx;color:#666;background:#eee}.priority.high{color:#8e5200;background:#fff0cc}.priority.urgent{color:#a20c39;background:#ffdee6}.urgent-panel{border-color:#eaa6b8;background:#fff8fa}.dark{background:#171b24;color:#eceef4;min-height:100vh}.dark .card,.dark button,.dark input,.dark textarea,.dark .picker{background:#242a35;color:#eceef4;border-color:#3c4656}.dark .muted{color:#b9c0ce}.ambient-particles{position:fixed;inset:0;pointer-events:none;opacity:.18;overflow:hidden;z-index:0}.page>.card,.page>.title,.page>.actions,.page>.stats,.page>.tabs{position:relative;z-index:1}.ambient-dot{position:absolute;width:8rpx;height:8rpx;border-radius:50%;background:var(--accent);animation:ambient-drift 14s linear infinite}.bubbles .ambient-dot,.orbits .ambient-dot{width:28rpx;height:28rpx;background:transparent;border:2rpx solid var(--accent)}.petals .ambient-dot{width:18rpx;height:10rpx;border-radius:80% 0}.rain .ambient-dot{width:2rpx;height:30rpx}.constellation .ambient-dot{box-shadow:20rpx 20rpx 0 var(--accent)}.stars .ambient-dot,.fireflies .ambient-dot{animation:ambient-glow 3s ease-in-out infinite}@keyframes ambient-drift{0%{transform:translate(0,-40rpx);opacity:0}20%{opacity:1}100%{transform:translate(40rpx,200rpx);opacity:0}}@keyframes ambient-glow{0%,100%{opacity:.2;transform:scale(.6)}50%{opacity:1;transform:scale(1.3)}}.mini-person-home{position:fixed;bottom:30rpx;left:8%;right:8%;z-index:30;border:2rpx solid var(--accent);box-shadow:0 10rpx 60rpx #0003}.bubble-board{height:740rpx;position:relative;margin:30rpx 0;background:radial-gradient(ellipse,#fff2df,transparent)}.bubble-center{position:absolute;left:35%;top:43%;width:30%;text-align:center;border:2rpx solid var(--accent);border-radius:50%;padding:30rpx 0;background:white}.mini-cluster{position:absolute;transform:translate(-50%,-50%);width:240rpx;z-index:2}.mini-dept-bubble{border-radius:70rpx;padding:20rpx 8rpx;border:2rpx solid var(--dept-color);background:white;text-align:center;font-size:26rpx}.mini-orbit{display:flex;flex-wrap:wrap;justify-content:center;gap:8rpx}.mini-member{border:1rpx solid var(--dept-color);border-radius:40rpx;padding:10rpx;width:104rpx;text-align:center;background:white;font-size:22rpx}.mini-member image{width:42rpx;height:42rpx;border-radius:50%}.bubble-line{position:absolute;height:2rpx;background:var(--accent);opacity:.25;transform-origin:left center}.workspace-switch{color:var(--accent);border-radius:24rpx;font-size:26rpx}.time-track{border:0!important;position:relative}.time-track:before{content:'';position:absolute;top:45%;left:0;right:0;height:2rpx;background:var(--accent);opacity:.25}.time-day{border:0!important;border-radius:25rpx;position:relative;margin:8rpx;background:#fffaf3}
